          {"id": "revision_synthesis", "label": "Revision synthesis"},
          {"id": "constraint_discharge_review", "label": "Discharge review"},
          {"id": "spec_publication", "label": "Spec publication"},
          {"id": "final_review", "label": "Final review (typecheck)"}
