        "edges": [
          {"from": "survey", "to": "convener_synthesis"},
          {"from": "convener_synthesis", "to": "cross_exam"},
          {"from": "cross_exam", "to": "adjudication"},
          {"from": "adjudication", "to": "revision_synthesis"},
          {"from": "revision_synthesis", "to": "constraint_discharge_review"},
          {"from": "constraint_discharge_review", "to": "spec_publication"},
          {"from": "spec_publication", "to": "final_review"}
        ],
        "cycles": [{"from": "adjudication", "to": "convener_synthesis", "on_verdict": "needs_revision"}]
      }
    },
