  "harness_profile_fragments": [
    {
      "profile_id": "claude_code_default",
      "kind": "harness_profile_fragment",
      "tool_family": "claude_code",
      "display_name": "Claude Code default profile",
      "summary": "Sub-agent-friendly profile with the RFC 0040 V1 no-questions instruction.",
      "native_delegation_mode": "preferred",
      "native_delegation_instruction": "Use sub-agents aggressively for bounded independent research, review, and code/test/doc authorship. This is a one-shot supervised invocation: you cannot ask the operator a follow-up question. If permission to call `striatum ack` is denied, write the artifact and exit normally; the operator publishes on your behalf. Do not let native delegation obscure the parent session's artifact and verdict accountability."
    },
    {
      "profile_id": "codex_default",
      "kind": "harness_profile_fragment",
      "tool_family": "codex",
      "display_name": "Codex default profile",
      "summary": "Encourages native delegation with the RFC 0040 V1 no-questions instruction.",
      "native_delegation_mode": "encouraged",
      "native_delegation_instruction": "Use native delegation aggressively for parallelizable work. The parent session remains accountable for Striatum artifacts, write scope, verification, and completion. This is a one-shot supervised invocation: you cannot ask the operator a follow-up question. If a step is ambiguous, choose the most-conservative default that matches the synthesis and proceed; the operator publishes the result on your behalf if your CLI access is denied."
    },
    {
      "profile_id": "generic_default",
      "kind": "harness_profile_fragment",
      "tool_family": "generic",
      "display_name": "Generic default profile",
      "summary": "Default profile for unspecified tool families.",
      "native_delegation_mode": "not_applicable",
      "native_delegation_instruction": "This is a one-shot supervised invocation: do not ask the operator a follow-up question. Write the expected artifact at the declared path and exit normally; the operator publishes on your behalf if direct CLI access is denied."
    },
    {
      "profile_id": "agy_default",
      "kind": "harness_profile_fragment",
      "tool_family": "agy",
      "display_name": "Antigravity default profile",
      "summary": "Default profile for the Antigravity agent harness.",
      "native_delegation_mode": "preferred",
      "native_delegation_instruction": "Use native delegation for parallelizable tasks. The parent session remains accountable for Striatum artifacts. Do not ask follow-up questions, just execute one-shot."
    }
  ]
