{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "rfc0114-read-scope",
  "workflow_version": "2026-06-06",
  "name": "RFC successor: read-scope least privilege (principals + sessions)",
  "branch": {
    "mode": "confirm",
    "suggested_name": "rfc/0114-read-scope-principals-sessions",
    "allow_dirty": true
  },
  "coordinator": {
    "role_id": "author",
    "lane_id": "claude"
  },
  "allow_same_model_review_pairing": false,
  "context_docs": [
    { "path": "docs/rfcs/0113-runtime-read-scope-least-privilege.md", "required": true },
    { "path": "docs/dogfoods/rfc0114-read-scope/CONTEXT.md", "required": true }
  ],
  "lanes": {
    "claude": {
      "adapter": "process",
      "display_model": "Claude Opus 4.8",
      "command": [
        "claude",
        "--dangerously-skip-permissions",
        "--model",
        "claude-opus-4-8"
      ],
      "adapter_capabilities": { "agent_loop": true },
      "supervision": { "transport": "pty_helper", "compatible": true, "require_tmux": true },
      "worktree_isolation": "per_job",
      "capabilities": ["write", "review", "synthesis"]
    },
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5 xhigh",
      "command": ["codex", "--yolo"],
      "adapter_capabilities": { "agent_loop": true },
      "supervision": { "transport": "pty_helper", "compatible": true, "require_tmux": true },
      "capabilities": ["write", "review", "synthesis"]
    }
  },
  "roles": {
    "author": { "definition_path": "roles/author.md" },
    "reviewer": { "definition_path": "roles/reviewer.md" }
  },
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 1,
    "require_disjoint_write_scopes": true
  },
  "review_revision_policy": {
    "max_revisions": 1,
    "root_review_needs_revision": "human_checkpoint"
  },
  "cycles": [],
  "edges": [
    { "from": "draft", "on": "completed", "to": "review" },
    { "from": "review", "on": "completed", "to": "synth" }
  ],
  "jobs": [
    {
      "id": "draft",
      "type": "draft",
      "title": "Draft RFC 0114: read-scope least privilege for principals + client_sessions",
      "role_id": "author",
      "lane_id": "claude",
      "objective": "Author the successor design RFC that extends RFC 0113 R1 to the next projection-gated read surfaces (principals/principal_clients and/or client_sessions). The panel must pick and justify the ordering, the owner-bundle plan, guard tests, doctor posture transitions, rollout + verification steps, and revisit triggers.",
      "task_prompt": { "path": "prompts/draft.md" },
      "worktree_required": true,
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/dogfoods/rfc0114-read-scope/artifacts/"
        ],
        "forbidden_paths": [".striatum/", "go/", "docs/rfcs/", "docs/decisions/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "rfc_draft",
          "kind": "handoff",
          "path": "docs/dogfoods/rfc0114-read-scope/artifacts/RFC_DRAFT.md",
          "required": true
        }
      ]
    },
    {
      "id": "review",
      "type": "review",
      "title": "Independent cross-family review of the RFC draft",
      "role_id": "reviewer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Read the RFC draft and the RFC 0113 context. Verify the design is implementable against the real owner-bundle / SECURITY DEFINER / guard-test / doctor-posture machinery, that the projection ownership constraint (principals/client_sessions are runtime-role-owned, not owner-owned) is correctly handled, that the doctor posture transition is correct, and that rollout is owner-applied out-of-band with no live schema change from this design task. Record a finding with a verdict.",
      "task_prompt": { "path": "prompts/review.md" },
      "review_policy": {
        "access_scope": "artifact_plus_context",
        "context_policy": "draft_and_required_context",
        "instruction": "Falsify the design where you can. Confirm the owner-bundle plan, guard tests, doctor posture transitions, and rollout steps are concrete and correct against the cited source files. Issue needs_revision if the projection ownership constraint, the doctor posture transition, or the guard-test plan is wrong or missing; otherwise accept or accept_with_findings."
      },
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["docs/dogfoods/rfc0114-read-scope/artifacts/review/"],
        "forbidden_paths": [".striatum/", "go/", "docs/rfcs/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review_finding",
          "kind": "finding",
          "path": "docs/dogfoods/rfc0114-read-scope/artifacts/review/REVIEW.md",
          "required": true
        }
      ]
    },
    {
      "id": "synth",
      "type": "synthesis",
      "title": "Finalize the RFC incorporating accepted review findings",
      "role_id": "author",
      "lane_id": "claude",
      "objective": "Incorporate the review findings into a final, publishable RFC. Produce the finalized RFC body that will be placed at docs/rfcs/0114-*.md on the review branch by the operator.",
      "task_prompt": { "path": "prompts/synth.md" },
      "worktree_required": true,
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/dogfoods/rfc0114-read-scope/artifacts/"
        ],
        "forbidden_paths": [".striatum/", "go/", "docs/rfcs/", "docs/decisions/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "rfc_final",
          "kind": "synthesis",
          "path": "docs/dogfoods/rfc0114-read-scope/artifacts/RFC_FINAL.md",
          "required": true
        }
      ]
    }
  ]
}
