{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "dogfood-007-local-web-ui",
  "workflow_version": "2026-05-08",
  "name": "Dogfood 007: Ship RFC 0013 V1 (local web UI)",
  "branch": {"mode": "auto", "suggested_name": "striatum/dogfood-007-local-web-ui", "allow_dirty": false},
  "coordinator": {"role_id": "coordinator", "lane_id": "codex"},
  "harness_profiles": {
    "codex_default": {
      "tool_family": "codex",
      "strategy_version": "2026-05-08",
      "native_delegation": {"mode": "encouraged", "instruction": "Use sub-agents."},
      "feature_flags": {"subagents": "allowed_via_natural_language_routing", "skills": "encouraged"},
      "supervision": {"compatible": true, "stdin_format": "packet", "wrapper_required": false},
      "approval_mode": "default",
      "memory_files": ["AGENTS.md"],
      "accountability": {"native_subagents": "internal_to_parent_session", "first_class_registration": "not_supported"}
    },
    "claude_code_default": {
      "tool_family": "claude_code",
      "strategy_version": "2026-05-08",
      "native_delegation": {"mode": "preferred", "instruction": "Spawn sub-agents."},
      "feature_flags": {"subagents": "preferred", "skills": "encouraged", "headless_print_mode": "forbidden_for_supervised_lanes"},
      "supervision": {"compatible": true, "stdin_format": "newline_delimited_json", "wrapper_required": true},
      "approval_mode": "auto_edit",
      "memory_files": ["CLAUDE.md", "AGENTS.md"],
      "accountability": {"native_subagents": "internal_to_parent_session", "first_class_registration": "not_supported"}
    }
  },
  "lanes": {
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5",
      "command": ["codex", "exec", "--json", "--ephemeral", "--skip-git-repo-check", "--sandbox", "workspace-write", "--ask-for-approval", "never", "--ignore-user-config", "-"],
      "capabilities": ["write", "review", "synthesis"],
      "constraints": {"transcripts": "off", "repo_scope": "local_only", "network": "forbidden"},
      "required_enforcement": {"transcripts": "enforced"},
      "harness_profile_id": "codex_default",
      "env": {"CODEX_HOME": "${STRIATUM_SCRATCH_DIR}/codex-home"}
    },
    "claude_code": {
      "adapter": "process",
      "display_model": "Claude Opus",
      "command": [".striatum/bin/claude-supervised-wrapper.sh"],
      "capabilities": ["write", "review", "synthesis"],
      "constraints": {"transcripts": "off", "repo_scope": "local_only"},
      "required_enforcement": {"transcripts": "enforced"},
      "harness_profile_id": "claude_code_default"
    }
  },
  "roles": {
    "researcher": {"definition_path": "docs/dogfood/007/roles/researcher.md"},
    "designer": {"definition_path": "docs/dogfood/007/roles/designer.md"},
    "reviewer": {"definition_path": "docs/dogfood/007/roles/reviewer.md"},
    "implementer": {"definition_path": "docs/dogfood/007/roles/implementer.md"},
    "coordinator": {"definition_path": "docs/dogfood/007/roles/coordinator.md"}
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "README.md", "required": true},
    {"path": "docs/SPEC.md", "required": true},
    {"path": "docs/rfcs/0013-local-web-ui.md", "required": true},
    {"path": "docs/rfcs/0012-local-service-api.md", "required": true},
    {"path": "src/striatum/service.py", "required": false},
    {"path": "src/striatum/artifacts.py", "required": false}
  ],
  "parallelism": {"mode": "declared", "max_active_jobs": 1, "require_disjoint_write_scopes": true},
  "jobs": [
    {
      "id": "research_web_ui_surface",
      "type": "generic",
      "title": "Survey RFC 0012 service endpoints + RFC 0005/0010/0014 artifact kinds for the web UI",
      "role_id": "researcher",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Confirm RFC 0012 endpoints land what the UI needs; map artifact kinds to per-kind formatting; choose the static asset stack.",
      "task_prompt": {"path": "docs/dogfood/007/prompts/research_web_ui.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/dogfood/007/research/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "web_ui_research", "kind": "handoff", "path": "docs/dogfood/007/research/WEB_UI_SURFACE.md", "required": true}]
    },
    {
      "id": "synthesize_v1_design",
      "type": "synthesis",
      "title": "Lock RFC 0013 V1 design (steps 1-6: SPA shell + 4 views + artifact viewer)",
      "role_id": "designer",
      "lane_id": "codex",
      "objective": "Pin static-asset layout, route table, JS framework choice (vanilla vs Preact), CSS budget, per-kind artifact rendering rules, SSE consumption pattern, and test plan.",
      "task_prompt": {"path": "docs/dogfood/007/prompts/synthesize_v1_design.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/dogfood/007/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "v1_design", "kind": "synthesis", "path": "docs/dogfood/007/DESIGN_SYNTHESIS.md", "required": true}]
    },
    {
      "id": "review_v1_design",
      "type": "review",
      "title": "Review RFC 0013 V1 design",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "fresh_session_required": true,
      "reviewer_access_scope": "artifact_augmented",
      "reviewer_context_policy": "fresh",
      "objective": "Verify the V1 SPA preserves D020 (no external CDN imports), is bundled inside the wheel (no npm install at install time), reuses RFC 0012 endpoints exclusively, and ships a tractable smallest slice.",
      "task_prompt": {"path": "docs/dogfood/007/prompts/review_v1_design.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/dogfood/007/review/design/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "v1_design_review", "kind": "finding", "path": "docs/dogfood/007/review/design/DESIGN_REVIEW.md", "required": true}]
    },
    {
      "id": "implement_v1",
      "type": "build",
      "title": "Implement RFC 0013 V1 (steps 1-6 SPA + service --web wiring + tests)",
      "role_id": "implementer",
      "lane_id": "codex",
      "objective": "Ship src/striatum/web/static/, wire service.py to serve assets when --web is set, implement run list + run detail + job detail + artifact viewer + doctor views with vanilla JS, add tests.",
      "task_prompt": {"path": "docs/dogfood/007/prompts/implement_v1.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["src/striatum/", "tests/", "docs/SPEC.md", "docs/UBIQUITOUS_LANGUAGE.md", "docs/DECISION_LOG.md", "docs/TODO.md", "docs/rfcs/0013-local-web-ui.md", "docs/rfcs/README.md", "docs/dogfood/007/", "docs/dogfood/FRICTION_LOG.md", "examples/", "README.md", "CHANGELOG.md", "pyproject.toml", "MANIFEST.in"], "forbidden_paths": [".striatum/state.sqlite3"]},
      "expected_artifacts": [{"logical_name": "v1_handoff", "kind": "handoff", "path": "docs/dogfood/007/BUILD_HANDOFF.md", "required": true}]
    },
    {
      "id": "review_v1_build",
      "type": "review",
      "title": "Review RFC 0013 V1 implementation",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "fresh_session_required": true,
      "reviewer_access_scope": "repo_level",
      "reviewer_context_policy": "fresh",
      "objective": "Verify SPA shape matches accepted design; no external URLs in shipped assets; service routes / when --web is set; artifact viewer formats per kind; SSE wiring uses RFC 0012 endpoints exclusively.",
      "task_prompt": {"path": "docs/dogfood/007/prompts/review_v1_build.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/dogfood/007/review/build/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "v1_build_review", "kind": "finding", "path": "docs/dogfood/007/review/build/BUILD_REVIEW.md", "required": true}]
    }
  ],
  "edges": [
    {"from": "research_web_ui_surface", "to": "synthesize_v1_design", "on": "completed"},
    {"from": "synthesize_v1_design", "to": "review_v1_design", "on": "completed"},
    {"from": "review_v1_design", "to": "implement_v1", "on": "completed"},
    {"from": "implement_v1", "to": "review_v1_build", "on": "completed"}
  ],
  "cycles": [
    {"from": "review_v1_design", "to": "synthesize_v1_design", "on_verdict": "needs_revision", "max_iterations": 1},
    {"from": "review_v1_build", "to": "implement_v1", "on_verdict": "needs_revision", "max_iterations": 1}
  ]
}
