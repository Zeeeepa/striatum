{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "dogfood-006-local-service-api",
  "workflow_version": "2026-05-08",
  "name": "Dogfood 006: Ship RFC 0012 V1 (local service API)",
  "branch": {
    "mode": "auto",
    "suggested_name": "striatum/dogfood-006-local-service-api",
    "allow_dirty": false
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "codex"},
  "harness_profiles": {
    "codex_default": {
      "tool_family": "codex",
      "strategy_version": "2026-05-08",
      "native_delegation": {"mode": "encouraged", "instruction": "Use sub-agents by routing the parent prompt; ship .codex/agents/<role>.toml definitions."},
      "feature_flags": {"subagents": "allowed_via_natural_language_routing", "skills": "encouraged"},
      "supervision": {"compatible": true, "stdin_format": "packet", "wrapper_required": false},
      "approval_mode": "default",
      "memory_files": ["AGENTS.md"],
      "accountability": {"native_subagents": "internal_to_parent_session", "first_class_registration": "not_supported"}
    },
    "claude_code_default": {
      "tool_family": "claude_code",
      "strategy_version": "2026-05-08",
      "native_delegation": {"mode": "preferred", "instruction": "Spawn the maximum number of useful sub-agents whose work is bounded, independent, and stays inside the packet write scope."},
      "feature_flags": {"subagents": "preferred", "skills": "encouraged", "headless_print_mode": "forbidden_for_supervised_lanes"},
      "supervision": {"compatible": true, "stdin_format": "newline_delimited_json", "wrapper_required": true},
      "approval_mode": "auto_edit",
      "memory_files": ["CLAUDE.md", "AGENTS.md"],
      "accountability": {"native_subagents": "internal_to_parent_session", "first_class_registration": "not_supported"}
    }
  },
  "lanes": {
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5",
      "command": ["codex", "exec", "--json", "--ephemeral", "--skip-git-repo-check", "--sandbox", "workspace-write", "--ask-for-approval", "never", "--ignore-user-config", "-"],
      "capabilities": ["write", "review", "synthesis"],
      "constraints": {"transcripts": "off", "repo_scope": "local_only", "network": "forbidden"},
      "required_enforcement": {"transcripts": "enforced"},
      "harness_profile_id": "codex_default",
      "env": {"CODEX_HOME": "${STRIATUM_SCRATCH_DIR}/codex-home"}
    },
    "claude_code": {
      "adapter": "process",
      "display_model": "Claude Opus",
      "command": [".striatum/bin/claude-supervised-wrapper.sh"],
      "capabilities": ["write", "review", "synthesis"],
      "constraints": {"transcripts": "off", "repo_scope": "local_only"},
      "required_enforcement": {"transcripts": "enforced"},
      "harness_profile_id": "claude_code_default"
    }
  },
  "roles": {
    "researcher": {"definition_path": "docs/dogfood/006/roles/researcher.md"},
    "designer": {"definition_path": "docs/dogfood/006/roles/designer.md"},
    "reviewer": {"definition_path": "docs/dogfood/006/roles/reviewer.md"},
    "implementer": {"definition_path": "docs/dogfood/006/roles/implementer.md"},
    "coordinator": {"definition_path": "docs/dogfood/006/roles/coordinator.md"}
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "README.md", "required": true},
    {"path": "docs/SPEC.md", "required": true},
    {"path": "docs/DECISION_LOG.md", "required": true},
    {"path": "docs/rfcs/0012-local-service-api.md", "required": true},
    {"path": "src/striatum/api.py", "required": false},
    {"path": "src/striatum/mcp.py", "required": false},
    {"path": "src/striatum/cli/parser.py", "required": false},
    {"path": "src/striatum/dashboard.py", "required": false}
  ],
  "parallelism": {"mode": "declared", "max_active_jobs": 1, "require_disjoint_write_scopes": true},
  "jobs": [
    {
      "id": "research_service_surface",
      "type": "generic",
      "title": "Survey api.invoke, mcp.py, and standard-library HTTP/Unix-socket options",
      "role_id": "researcher",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Map the existing api.invoke surface and the events table read pattern; identify the smallest stdlib-only HTTP + Unix-socket server that satisfies RFC 0012's V1 endpoints. Confirm RFC claims against current source; flag drift.",
      "task_prompt": {"path": "docs/dogfood/006/prompts/research_service_surface.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/dogfood/006/research/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "service_research", "kind": "handoff", "path": "docs/dogfood/006/research/SERVICE_SURFACE.md", "required": true}]
    },
    {
      "id": "synthesize_v1_design",
      "type": "synthesis",
      "title": "Lock RFC 0012 V1 design (HTTP + Unix-socket, SSE for events, mutation gating)",
      "role_id": "designer",
      "lane_id": "codex",
      "objective": "Pin: stdlib server choice, exact endpoint routing, SSE event payload shape, mutation-detection rule, auth model, refusal of non-loopback hosts, PID-file location, test plan including all RFC 0012 acceptance criteria.",
      "task_prompt": {"path": "docs/dogfood/006/prompts/synthesize_v1_design.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/dogfood/006/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "v1_design", "kind": "synthesis", "path": "docs/dogfood/006/DESIGN_SYNTHESIS.md", "required": true}]
    },
    {
      "id": "review_v1_design",
      "type": "review",
      "title": "Review RFC 0012 V1 design",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "fresh_session_required": true,
      "reviewer_access_scope": "artifact_augmented",
      "reviewer_context_policy": "fresh",
      "objective": "Verify the V1 service preserves D020 (no remote serving), routes every state change through api.invoke, and meets the V1 acceptance criteria with a test plan that exercises non-loopback refusal, SSE replay, and mutation gating.",
      "task_prompt": {"path": "docs/dogfood/006/prompts/review_v1_design.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/dogfood/006/review/design/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "v1_design_review", "kind": "finding", "path": "docs/dogfood/006/review/design/DESIGN_REVIEW.md", "required": true}]
    },
    {
      "id": "implement_v1",
      "type": "build",
      "title": "Implement RFC 0012 V1 (striatum serve + endpoints + SSE)",
      "role_id": "implementer",
      "lane_id": "codex",
      "objective": "Ship src/striatum/service.py with the HTTP/Unix-socket server, all V1 endpoints (/v1/health, /v1/invoke, /v1/runs[*], /v1/doctor, SSE events), --allow-mutations gating, --token auth, non-loopback refusal, PID-file lifecycle, graceful shutdown, and tests covering all acceptance criteria.",
      "task_prompt": {"path": "docs/dogfood/006/prompts/implement_v1.md"},
      "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["src/striatum/", "tests/", "docs/SPEC.md", "docs/UBIQUITOUS_LANGUAGE.md", "docs/DECISION_LOG.md", "docs/TODO.md", "docs/rfcs/0012-local-service-api.md", "docs/rfcs/README.md", "docs/dogfood/006/", "docs/dogfood/FRICTION_LOG.md", "examples/", "README.md", "CHANGELOG.md"], "forbidden_paths": [".striatum/state.sqlite3"]},
      "expected_artifacts": [{"logical_name": "v1_handoff", "kind": "handoff", "path": "docs/dogfood/006/BUILD_HANDOFF.md", "required": true}]
    },
    {
      "id": "review_v1_build",
      "type": "review",
      "title": "Review RFC 0012 V1 implementation",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "fresh_session_required": true,
      "reviewer_access_scope": "repo_level",
      "reviewer_context_policy": "fresh",
      "objective": "Verify the service shape matches the accepted design: endpoints, mutation gating, SSE replay, non-loopback refusal, auth, lifecycle, test coverage, and D020/D028/D006 compliance.",
      "task_prompt": {"path": "docs/dogfood/006/prompts/review_v1_build.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/dogfood/006/review/build/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "v1_build_review", "kind": "finding", "path": "docs/dogfood/006/review/build/BUILD_REVIEW.md", "required": true}]
    }
  ],
  "edges": [
    {"from": "research_service_surface", "to": "synthesize_v1_design", "on": "completed"},
    {"from": "synthesize_v1_design", "to": "review_v1_design", "on": "completed"},
    {"from": "review_v1_design", "to": "implement_v1", "on": "completed"},
    {"from": "implement_v1", "to": "review_v1_build", "on": "completed"}
  ],
  "cycles": [
    {"from": "review_v1_design", "to": "synthesize_v1_design", "on_verdict": "needs_revision", "max_iterations": 1},
    {"from": "review_v1_build", "to": "implement_v1", "on_verdict": "needs_revision", "max_iterations": 1}
  ]
}
