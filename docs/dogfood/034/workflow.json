  "jobs": [
    {
      "id": "design_codex",
      "type": "generic",
      "title": "Design RFC 0030 RPC + RFC 0031 supervision/sealed apply from Codex",
      "role_id": "designer",
      "lane_id": "codex",
      "parallel_group": "fresh_design",
      "fresh_session_required": true,
      "objective": "Produce a paired implementation design for RFC 0030 daemon RPC server + version skew protocol AND RFC 0031 daemon-owned supervision + sealed-apply boundary. Cover wire framing, transports, version handshake, capability-bound routes, audit shape, request log, supervisor ownership migration, sealed apply receipt format, signing key custody, and how all of it sits on top of the RFC 0033 daemon Postgres substrate that just landed in dogfood-033.",
      "task_prompt": {"path": "docs/dogfood/034/prompts/design_codex.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": ["docs/dogfood/034/design/codex/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "codex_design",
          "kind": "handoff",
          "path": "docs/dogfood/034/design/codex/DESIGN.md",
          "required": true
        }
      ]
    },
    {
      "id": "design_claude_code",
      "type": "generic",
      "title": "Design RFC 0030 + RFC 0031 from Claude Code",
      "role_id": "designer",
      "lane_id": "claude_code",
      "parallel_group": "fresh_design",
      "fresh_session_required": true,
      "objective": "Produce a paired implementation design for RFC 0030 + RFC 0031. Emphasize trust boundaries (daemon process, RPC clients, supervised lane processes, operator), capability vocabulary + token lifecycle + revocation, sealed apply gate semantics, apply receipt format and provenance limits (RFC 0031 threat model: AI guardrail, not malicious-operator defense), supervisor reattach across daemon restart, and the V1→V2 migration story for repo-local supervisor rows.",
      "task_prompt": {"path": "docs/dogfood/034/prompts/design_claude_code.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": ["docs/dogfood/034/design/claude_code/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "claude_code_design",
          "kind": "handoff",
          "path": "docs/dogfood/034/design/claude_code/DESIGN.md",
          "required": true
        }
      ]
    },
    {
      "id": "design_gemini",
      "type": "generic",
      "title": "Design RFC 0030 + RFC 0031 from Gemini",
      "role_id": "designer",
      "lane_id": "gemini",
      "parallel_group": "fresh_design",
      "fresh_session_required": true,
      "objective": "Produce a paired implementation design for RFC 0030 + RFC 0031. Emphasize cross-platform process supervision (launchd/systemd/Windows), socket vs loopback HTTP transports per platform, signing-key custody using OS keyring or 0600 fallback, packaging deltas, operator onboarding for daemon RPC + apply tokens, and adversarial test cases including hostile MCP clients and supervisor reattach after daemon crash.",
      "task_prompt": {"path": "docs/dogfood/034/prompts/design_gemini.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": ["docs/dogfood/034/design/gemini/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "gemini_design",
          "kind": "handoff",
          "path": "docs/dogfood/034/design/gemini/DESIGN.md",
          "required": true
        }
      ]
    },
    {
      "id": "synthesize_design",
      "type": "synthesis",
      "title": "Synthesize RFC 0030 + RFC 0031 paired implementation plan",
      "role_id": "designer",
      "lane_id": "codex",
      "objective": "Reconcile all three fresh design artifacts into one paired implementation plan for RFC 0030 + RFC 0031. Pick concrete envelope/framing, version handshake rules, capability vocabulary, supervisor ownership migration, sealed apply receipt format, signing key custody, and how mutations flow over the new RPC trust boundary. Sit the design on top of the RFC 0033 daemon Postgres substrate that just landed. Make all deferrals (cross-repo, MCP mutation tools, full Go port) explicit.",
      "task_prompt": {"path": "docs/dogfood/034/prompts/synthesize_design.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": ["docs/dogfood/034/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "design_synthesis",
          "kind": "synthesis",
          "path": "docs/dogfood/034/DESIGN_SYNTHESIS.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_design_threat",
      "type": "review",
      "title": "Threat-model review of RFC 0030 + RFC 0031 design",
      "role_id": "reviewer",
      "lane_id": "gemini",
      "fresh_session_required": true,
      "reviewer_access_scope": "artifact_augmented",
      "reviewer_context_policy": "fresh",
      "review_posture": "threat_model",
      "objective": "Review the paired RPC + supervision/sealed-apply plan against explicit trust boundaries: daemon process compromise, prompt-injected MCP clients, capability token theft, supervisor reattach after daemon crash, sealed apply receipt forgery within the documented AI-guardrail scope (RFC 0031 threat model), version-skew downgrade attacks, audit-chain integrity across RPC calls, and operator-mistake footguns. Malicious-local-root operator is out of scope per RFC 0031.",
      "task_prompt": {"path": "docs/dogfood/034/prompts/review_design.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["docs/dogfood/034/review/design/threat/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "design_review_threat",
          "kind": "finding",
          "path": "docs/dogfood/034/review/design/threat/REVIEW.md",
          "required": true
        }
      ]
    },
    {
      "id": "implement",
      "type": "build",
      "title": "Implement RFC 0030 + RFC 0031 V2 slice",
      "role_id": "implementer",
      "lane_id": "codex",
      "required_review_postures": ["threat_model"],
      "objective": "Implement only the reviewed and accepted V2 slice from docs/dogfood/034/DESIGN_SYNTHESIS.md. This job is blocked until review_design_threat returns an accepting verdict. Use sub-agents aggressively for parallelizable work per the implement prompt; the parent session remains accountable for verification, BUILD_HANDOFF, and scope discipline.",
      "task_prompt": {"path": "docs/dogfood/034/prompts/implement.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "src/striatum/",
          "tests/",
          "docs/SPEC.md",
          "docs/UBIQUITOUS_LANGUAGE.md",
          "docs/DECISION_LOG.md",
          "docs/TODO.md",
          "docs/MCP.md",
          "docs/CLI_REFERENCE.md",
          "docs/HOW_TO_HUMAN.md",
          "docs/rfcs/0030-daemon-rpc-server-and-version-skew-protocol.md",
          "docs/rfcs/0031-daemon-owned-supervision-and-sealed-apply-boundary.md",
          "docs/rfcs/0028-long-running-daemon-and-multi-repository-control-plane.md",
          "docs/rfcs/README.md",
          "docs/dogfood/034/",
          "README.md",
          "CHANGELOG.md",
          "pyproject.toml"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "build_handoff",
          "kind": "handoff",
          "path": "docs/dogfood/034/BUILD_HANDOFF.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_build_threat",
      "type": "review",
      "title": "Threat-model review of RFC 0030 + RFC 0031 V2 build",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "fresh_session_required": true,
      "reviewer_access_scope": "repo_level",
      "reviewer_context_policy": "fresh",
      "review_posture": "threat_model",
      "objective": "Review the implementation under threat-model posture: capability authorization correctness on every RPC route, audit row appended for every mutating request, supervisor reattach behavior across daemon restart, sealed apply refusal on digest/base-tree/verdict mismatch, signing key custody honesty (OS keyring or 0600 fallback per RFC 0031), version-handshake refusal semantics, and absence of raw `.striatum/state.sqlite3` write paths through daemon clients. Scope is over-eager AI and operator-mistake footguns per RFC 0031 threat model; malicious-local-root is out of scope.",
      "task_prompt": {"path": "docs/dogfood/034/prompts/review_build.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["docs/dogfood/034/review/build/threat/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "build_review_threat",
          "kind": "finding",
          "path": "docs/dogfood/034/review/build/threat/REVIEW.md",
          "required": true
        }
      ]
    }
  ],
