          "logical_name": "design_review",
          "kind": "finding",
          "path": "docs/dogfood/003/review/design/DESIGN_REVIEW.md",
          "required": true
        }
      ]
    },
    {
      "id": "implement_profiles",
      "type": "build",
      "title": "Implement accepted RFC 0010 profile slice",
      "role_id": "implementer",
      "lane_id": "codex",
      "objective": "After human acceptance is recorded, implement the first reviewed V1 slice of RFC 0010: profile validation, lane references, work-packet exposure, fixtures, docs, and tests without building provider-specific wrappers or hosted integrations.",
      "task_prompt": {
        "path": "docs/dogfood/003/prompts/implement_profiles.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "src/striatum/",
          "tests/",
          "docs/SPEC.md",
          "docs/UBIQUITOUS_LANGUAGE.md",
          "docs/rfcs/0010-tool-harness-profiles.md",
          "docs/dogfood/003/",
          "README.md",
          "CHANGELOG.md"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "build_handoff",
          "kind": "handoff",
          "path": "docs/dogfood/003/BUILD_HANDOFF.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_build",
      "type": "review",
      "title": "Review RFC 0010 implementation",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "fresh_session_required": true,
      "reviewer_access_scope": "repo_level",
      "reviewer_context_policy": "fresh",
      "objective": "Review the implementation for behavior, tests, documentation, and adherence to RFC 0010.",
      "task_prompt": {
        "path": "docs/dogfood/003/prompts/review_build.md"
