    {
      "path": "docs/research/0010-tool-harness-profiles/claude_code.md",
      "required": true
    },
    {
      "path": "docs/research/0010-tool-harness-profiles/codex.md",
      "required": true
    },
    {
      "path": "docs/research/0010-tool-harness-profiles/gemini_cli.md",
      "required": true
    },
    {
      "path": "docs/dogfood/003/SOURCES.md",
      "required": true
    },
    {
      "path": "src/striatum/workflow.py",
      "required": false
    },
    {
      "path": "src/striatum/db.py",
      "required": false
    },
    {
      "path": "tests/test_cli_mvp.py",
      "required": false
    }
  ],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 3,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "research_codex",
      "type": "generic",
      "title": "Research Codex harness features",
      "role_id": "researcher",
      "lane_id": "codex",
      "parallel_group": "tool_research",
      "fresh_session_required": true,
      "objective": "Verify and refresh the RFC 0010 Codex harness profile against current docs and the existing research note, focusing on codex exec JSON mode, --ephemeral/CODEX_HOME isolation, skills, custom agent roles, MCP, approval mode, and agent-loop budget guardrails.",
      "task_prompt": {
        "path": "docs/dogfood/003/prompts/research_tool.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/dogfood/003/research/codex/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "codex_research",
          "kind": "handoff",
          "path": "docs/dogfood/003/research/codex/TOOL_RESEARCH.md",
          "required": true
        }
      ]
    },
    {
      "id": "research_claude_code",
      "type": "generic",
      "title": "Research Claude Code harness features",
      "role_id": "researcher",
      "lane_id": "claude_code",
      "parallel_group": "tool_research",
      "fresh_session_required": true,
      "objective": "Verify and refresh the RFC 0010 Claude Code harness profile against current docs and the existing research note, focusing on sub-agents, agent teams, hooks, skills, memory files, tool permissions, and the supervised-lane wrapper requirement.",
      "task_prompt": {
        "path": "docs/dogfood/003/prompts/research_tool.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/dogfood/003/research/claude_code/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "claude_code_research",
          "kind": "handoff",
          "path": "docs/dogfood/003/research/claude_code/TOOL_RESEARCH.md",
          "required": true
        }
      ]
    },
    {
      "id": "research_gemini",
      "type": "generic",
      "title": "Research Gemini CLI harness features",
      "role_id": "researcher",
      "lane_id": "gemini",
      "parallel_group": "tool_research",
      "fresh_session_required": true,
      "objective": "Verify and refresh the RFC 0010 Gemini CLI harness profile against current docs and the existing research note, focusing on local subagents, headless prompt/stdin behavior, stream-json output, MCP configuration, remote A2A boundaries, and native worktree risk.",
      "task_prompt": {
        "path": "docs/dogfood/003/prompts/research_tool.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/dogfood/003/research/gemini/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "gemini_research",
          "kind": "handoff",
          "path": "docs/dogfood/003/research/gemini/TOOL_RESEARCH.md",
          "required": true
        }
      ]
    },
    {
      "id": "synthesize_design",
      "type": "synthesis",
      "title": "Synthesize RFC 0010 implementation design",
      "role_id": "designer",
      "lane_id": "codex",
      "objective": "Synthesize the refreshed tool research and RFC 0010 concrete profiles into an implementation-ready design for the first accepted V1 slice.",
      "task_prompt": {
        "path": "docs/dogfood/003/prompts/synthesize_design.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/dogfood/003/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "design_synthesis",
          "kind": "synthesis",
          "path": "docs/dogfood/003/DESIGN_SYNTHESIS.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_design",
      "type": "review",
      "title": "Review RFC 0010 design synthesis",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "fresh_session_required": true,
      "reviewer_access_scope": "artifact_augmented",
      "reviewer_context_policy": "fresh",
      "objective": "Review the synthesized RFC 0010 design for correctness, scope, provider-boundary safety, and build readiness.",
      "task_prompt": {
        "path": "docs/dogfood/003/prompts/review_design.md"
