{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "dogfood-003-tool-harness-profiles",
  "workflow_version": "2026-05-08",
  "name": "Dogfood 003: Research and build tool harness profiles",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/dogfood-003-tool-harness-profiles",
    "allow_dirty": false
  },
  "coordinator": {
    "role_id": "coordinator",
    "lane_id": "codex"
  },
  "harness_profiles": {
    "generic_default": {
      "tool_family": "generic",
      "strategy_version": "2026-05-08",
      "native_delegation": {
        "mode": "off",
        "instruction": "Use the standard Striatum work packet. Do not assume native subagents, profile-specific memory files, hooks, or hosted coordination."
      },
      "feature_flags": {
        "subagents": "off",
        "agent_teams": "not_supported",
        "skills": "allowed_if_available",
        "mcp": "allowed_if_configured"
      },
      "supervision": {
        "compatible": true,
        "stdin_format": "packet",
        "wrapper_required": false
      },
      "approval_mode": "default",
      "output_format": "text",
      "memory_files": [
        "AGENTS.md"
      ],
      "accountability": {
        "native_subagents": "internal_to_parent_session",
        "first_class_registration": "not_supported"
      },
      "mcp_servers": []
    },
    "claude_code_default": {
      "tool_family": "claude_code",
      "strategy_version": "2026-05-08",
      "native_delegation": {
        "mode": "preferred",
        "instruction": "Spawn the maximum number of useful sub-agents whose work is bounded, independent, and stays inside the packet write scope. Prefer specialist sub-agents (review, research, fixture inspection) over broad repo-write fan-out. Agent teams are experimental; use sub-agents first.",
        "max_parallel_native_agents": "tool_default"
      },
      "feature_flags": {
        "subagents": "preferred",
        "agent_teams": "allowed_experimental",
        "skills": "encouraged",
        "custom_agent_roles": "allowed",
        "hooks": "encouraged",
        "mcp": "allowed",
        "headless_print_mode": "forbidden_for_supervised_lanes"
      },
      "supervision": {
        "compatible": true,
        "stdin_format": "newline_delimited_json",
        "wrapper_required": true
      },
      "approval_mode": "auto_edit",
      "memory_files": [
        "CLAUDE.md",
        "AGENTS.md"
      ],
      "accountability": {
        "native_subagents": "internal_to_parent_session",
        "first_class_registration": "not_supported"
      },
      "mcp_servers": []
    },
    "codex_default": {
      "tool_family": "codex",
      "strategy_version": "2026-05-08",
      "native_delegation": {
        "mode": "encouraged",
        "instruction": "Use sub-agents by routing the parent prompt; ship .codex/agents/<role>.toml definitions. Spawn parallel codex exec instances ONLY when each has its own CODEX_HOME and --ephemeral, otherwise session state corrupts (openai/codex#11435).",
        "max_parallel_native_agents": "tool_default"
      },
      "feature_flags": {
        "subagents": "allowed_via_natural_language_routing",
        "agent_teams": "not_supported",
        "skills": "encouraged",
        "custom_agent_roles": "allowed",
        "hooks": "allowed",
        "mcp": "allowed",
        "ephemeral_sessions": "required_for_parallel"
      },
      "workspace_isolation": {
        "state_dir_per_job": true,
        "rollout_persistence": "off"
      },
      "agent_loop_budget": {
        "auto_compact_limit": 280000,
        "model_reasoning_effort": "medium",
        "max_iterations": 8
      },
      "supervision": {
        "compatible": true,
        "stdin_format": "packet",
        "wrapper_required": false
      },
      "output_format": "json",
      "approval_mode": "default",
      "memory_files": [
        "AGENTS.md"
      ],
      "accountability": {
        "native_subagents": "internal_to_parent_session",
        "first_class_registration": "not_supported"
      },
      "mcp_servers": []
    },
    "gemini_cli_default": {
      "tool_family": "gemini_cli",
      "strategy_version": "2026-05-08",
      "native_delegation": {
        "mode": "allowed",
        "instruction": "Use @<agent-name> syntax to invoke local sub-agents authored under .gemini/agents/. Parallel sub-agents are supported but should be limited to read, research, test, or other non-overlapping work.",
        "max_parallel_native_agents": "tool_default"
      },
      "feature_flags": {
        "subagents": "allowed",
        "remote_subagents_a2a": "forbidden",
        "agent_teams": "not_supported",
        "skills": "allowed",
        "custom_agent_roles": "allowed",
        "hooks": "allowed",
        "mcp": "encouraged",
        "native_worktree": "forbidden"
      },
      "supervision": {
        "compatible": "verify_pipe_behavior_first",
        "stdin_format": "prompt_text",
        "wrapper_required": false
      },
      "approval_mode": "auto_edit",
      "output_format": "stream-json",
      "turn_caps": {
        "max_session_turns": null,
        "subagent_max_turns": 50,
        "subagent_timeout_mins": 30
      },
      "memory_files": [
        "GEMINI.md"
      ],
      "accountability": {
        "native_subagents": "internal_to_parent_session",
        "first_class_registration": "not_supported"
      },
      "mcp_servers": []
    }
  },
  "lanes": {
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5",
      "command": [
        "codex",
        "exec",
        "--json",
        "--ephemeral",
        "--skip-git-repo-check",
        "--sandbox",
        "workspace-write",
        "--ask-for-approval",
        "never",
        "--ignore-user-config",
        "-"
      ],
      "capabilities": [
        "write",
        "review",
        "synthesis"
      ],
      "constraints": {
        "transcripts": "off",
        "repo_scope": "local_only",
        "network": "forbidden"
      },
      "required_enforcement": {
        "transcripts": "enforced"
      },
      "harness_profile_id": "codex_default",
      "env": {
        "CODEX_HOME": "${STRIATUM_SCRATCH_DIR}/codex-home"
      }
    },
    "claude_code": {
      "adapter": "process",
      "display_model": "Claude Opus",
      "command": [
        ".striatum/bin/claude-supervised-wrapper.sh"
      ],
      "capabilities": [
        "write",
        "review",
        "synthesis"
      ],
      "constraints": {
        "transcripts": "off",
        "repo_scope": "local_only"
      },
      "required_enforcement": {
        "transcripts": "enforced"
      },
      "harness_profile_id": "claude_code_default"
    },
    "gemini": {
      "adapter": "process",
      "display_model": "Gemini Pro",
      "command": [
        "gemini",
        "--prompt",
        "-",
        "--output-format",
        "stream-json",
        "--approval-mode",
        "auto_edit"
      ],
      "capabilities": [
        "write",
        "review"
      ],
      "constraints": {
        "transcripts": "off",
        "repo_scope": "local_only"
      },
      "required_enforcement": {
        "transcripts": "enforced"
      },
      "harness_profile_id": "gemini_cli_default",
      "env": {
        "GEMINI_CLI_TRUST_WORKSPACE": "1"
      }
    }
  },
  "roles": {
    "researcher": {
      "definition_path": "docs/dogfood/003/roles/researcher.md"
    },
    "designer": {
      "definition_path": "docs/dogfood/003/roles/designer.md"
    },
    "reviewer": {
      "definition_path": "docs/dogfood/003/roles/reviewer.md"
    },
    "implementer": {
      "definition_path": "docs/dogfood/003/roles/implementer.md"
    },
    "coordinator": {
      "definition_path": "docs/dogfood/003/roles/coordinator.md"
    }
  },
  "context_docs": [
    {
      "path": "AGENTS.md",
      "required": true
    },
    {
      "path": "README.md",
      "required": true
    },
    {
      "path": "docs/SPEC.md",
      "required": true
    },
    {
      "path": "docs/DECISION_LOG.md",
      "required": true
