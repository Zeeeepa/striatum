      "from": "review_design",
      "to": "synthesize_design",
      "on_verdict": "needs_revision",
      "max_iterations": 1
    },
    {
      "from": "review_build",
      "to": "implement_profiles",
      "on_verdict": "needs_revision",
      "max_iterations": 1
    }
  ]
