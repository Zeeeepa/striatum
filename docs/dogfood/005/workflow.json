{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "dogfood-005-process-adapter-completion",
  "workflow_version": "2026-05-08",
  "name": "Dogfood 005: Ship RFC 0014 V1 (process adapter completion guarantees)",
  "branch": {
    "mode": "auto",
    "suggested_name": "striatum/dogfood-005-process-adapter-completion",
    "allow_dirty": false
  },
  "coordinator": {
    "role_id": "coordinator",
    "lane_id": "codex"
  },
  "harness_profiles": {
    "codex_default": {
      "tool_family": "codex",
      "strategy_version": "2026-05-08",
      "native_delegation": {
        "mode": "encouraged",
        "instruction": "Use sub-agents by routing the parent prompt; ship .codex/agents/<role>.toml definitions. Spawn parallel codex exec instances ONLY when each has its own CODEX_HOME and --ephemeral.",
        "max_parallel_native_agents": "tool_default"
      },
      "feature_flags": {
        "subagents": "allowed_via_natural_language_routing",
        "agent_teams": "not_supported",
        "skills": "encouraged",
        "custom_agent_roles": "allowed",
        "hooks": "allowed",
        "mcp": "allowed",
        "ephemeral_sessions": "required_for_parallel"
      },
      "workspace_isolation": {
        "state_dir_per_job": true,
        "rollout_persistence": "off"
      },
      "agent_loop_budget": {
        "auto_compact_limit": 280000,
        "model_reasoning_effort": "medium",
        "max_iterations": 8
      },
      "supervision": {
        "compatible": true,
        "stdin_format": "packet",
        "wrapper_required": false
      },
      "output_format": "json",
      "approval_mode": "default",
      "memory_files": ["AGENTS.md"],
      "accountability": {
        "native_subagents": "internal_to_parent_session",
        "first_class_registration": "not_supported"
      }
    },
    "claude_code_default": {
      "tool_family": "claude_code",
      "strategy_version": "2026-05-08",
      "native_delegation": {
        "mode": "preferred",
        "instruction": "Spawn the maximum number of useful sub-agents whose work is bounded, independent, and stays inside the packet write scope. Prefer specialist sub-agents.",
        "max_parallel_native_agents": "tool_default"
      },
      "feature_flags": {
        "subagents": "preferred",
        "agent_teams": "allowed_experimental",
        "skills": "encouraged",
        "custom_agent_roles": "allowed",
        "hooks": "encouraged",
        "mcp": "allowed",
        "headless_print_mode": "forbidden_for_supervised_lanes"
      },
      "supervision": {
        "compatible": true,
        "stdin_format": "newline_delimited_json",
        "wrapper_required": true
      },
      "approval_mode": "auto_edit",
      "memory_files": ["CLAUDE.md", "AGENTS.md"],
      "accountability": {
        "native_subagents": "internal_to_parent_session",
        "first_class_registration": "not_supported"
      }
    }
  },
  "lanes": {
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5",
      "command": [
        "codex", "exec", "--json", "--ephemeral",
        "--skip-git-repo-check",
        "--sandbox", "workspace-write",
        "--ask-for-approval", "never",
        "--ignore-user-config", "-"
      ],
      "capabilities": ["write", "review", "synthesis"],
      "constraints": {
        "transcripts": "off",
        "repo_scope": "local_only",
        "network": "forbidden"
      },
      "required_enforcement": {
        "transcripts": "enforced"
      },
      "harness_profile_id": "codex_default",
      "env": {
        "CODEX_HOME": "${STRIATUM_SCRATCH_DIR}/codex-home"
      }
    },
    "claude_code": {
      "adapter": "process",
      "display_model": "Claude Opus",
      "command": [".striatum/bin/claude-supervised-wrapper.sh"],
      "capabilities": ["write", "review", "synthesis"],
      "constraints": {
        "transcripts": "off",
        "repo_scope": "local_only"
      },
      "required_enforcement": {
        "transcripts": "enforced"
      },
      "harness_profile_id": "claude_code_default"
    }
  },
  "roles": {
    "researcher": {
      "definition_path": "docs/dogfood/005/roles/researcher.md"
    },
    "designer": {
      "definition_path": "docs/dogfood/005/roles/designer.md"
    },
    "reviewer": {
      "definition_path": "docs/dogfood/005/roles/reviewer.md"
    },
    "implementer": {
      "definition_path": "docs/dogfood/005/roles/implementer.md"
    },
    "coordinator": {
      "definition_path": "docs/dogfood/005/roles/coordinator.md"
    }
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "README.md", "required": true},
    {"path": "docs/SPEC.md", "required": true},
    {"path": "docs/DECISION_LOG.md", "required": true},
    {"path": "docs/rfcs/0014-process-adapter-completion-guarantees.md", "required": true},
    {"path": "docs/rfcs/0009-long-lived-process-supervision.md", "required": true},
    {"path": "docs/dogfood/005/SOURCES.md", "required": true},
    {"path": "src/striatum/process_adapter.py", "required": false},
    {"path": "src/striatum/db.py", "required": false},
    {"path": "src/striatum/cli/dispatch.py", "required": false},
    {"path": "src/striatum/cli/parser.py", "required": false},
    {"path": "src/striatum/cli/recovery.py", "required": false}
  ],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 1,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "research_current_adapter_path",
      "type": "generic",
      "title": "Survey the current process adapter behaviour and gaps",
      "role_id": "researcher",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Verify RFC 0014's claims against the current source. Inventory exact code paths in run_process_adapter that would need to change for each of the three V1 steps; flag anything the RFC's design missed.",
      "task_prompt": {
        "path": "docs/dogfood/005/prompts/research_current_adapter.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/dogfood/005/research/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "adapter_research",
          "kind": "handoff",
          "path": "docs/dogfood/005/research/CURRENT_ADAPTER.md",
          "required": true
        }
      ]
    },
    {
      "id": "synthesize_v1_design",
      "type": "synthesis",
      "title": "Lock the RFC 0014 V1 design (envelope + timeout + reconcile)",
      "role_id": "designer",
      "lane_id": "codex",
      "objective": "Produce an implementation-ready design synthesis for the combined three-step V1 build slice. Pin the diagnostic envelope schema, blocker-reason vocabulary, CLI surface for `--timeout-seconds` and `recovery process-reconcile`, doctor checks, and test plan.",
      "task_prompt": {
        "path": "docs/dogfood/005/prompts/synthesize_v1_design.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/dogfood/005/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "v1_design",
          "kind": "synthesis",
          "path": "docs/dogfood/005/DESIGN_SYNTHESIS.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_v1_design",
      "type": "review",
      "title": "Review the RFC 0014 V1 design synthesis",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "fresh_session_required": true,
      "reviewer_access_scope": "artifact_augmented",
      "reviewer_context_policy": "fresh",
      "objective": "Review the V1 design for correctness, scope, D028 compliance (no transcripts), schema impact, and test coverage. Use accept_with_findings unless a finding actually blocks acceptance.",
      "task_prompt": {
        "path": "docs/dogfood/005/prompts/review_v1_design.md"
      },
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": [
          "docs/dogfood/005/review/design/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "v1_design_review",
          "kind": "finding",
          "path": "docs/dogfood/005/review/design/DESIGN_REVIEW.md",
          "required": true
        }
      ]
    },
    {
      "id": "implement_v1",
      "type": "build",
      "title": "Implement RFC 0014 V1 (post-exit validation + timeout + reconcile)",
      "role_id": "implementer",
      "lane_id": "codex",
      "objective": "After human acceptance is recorded, ship the combined V1 slice: post-exit output validation with the diagnostic envelope, --timeout-seconds CLI flag and lane field, and recovery process-reconcile + two doctor checks. Add tests covering each failure mode plus the happy path.",
      "task_prompt": {
        "path": "docs/dogfood/005/prompts/implement_v1.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "src/striatum/",
          "tests/",
          "docs/SPEC.md",
          "docs/UBIQUITOUS_LANGUAGE.md",
          "docs/DECISION_LOG.md",
          "docs/TODO.md",
          "docs/rfcs/0014-process-adapter-completion-guarantees.md",
          "docs/dogfood/005/",
          "examples/",
          "README.md",
          "CHANGELOG.md"
        ],
        "forbidden_paths": [
          ".striatum/state.sqlite3"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "v1_handoff",
          "kind": "handoff",
          "path": "docs/dogfood/005/BUILD_HANDOFF.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_v1_build",
      "type": "review",
      "title": "Review the RFC 0014 V1 implementation",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "fresh_session_required": true,
      "reviewer_access_scope": "repo_level",
      "reviewer_context_policy": "fresh",
      "objective": "Review the V1 implementation for correctness, D028 / D020 compliance, schema impact, test coverage of all four failure modes, and reproduction shape from issue #1.",
      "task_prompt": {
        "path": "docs/dogfood/005/prompts/review_v1_build.md"
      },
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": [
          "docs/dogfood/005/review/build/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "v1_build_review",
          "kind": "finding",
          "path": "docs/dogfood/005/review/build/BUILD_REVIEW.md",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {"from": "research_current_adapter_path", "to": "synthesize_v1_design", "on": "completed"},
    {"from": "synthesize_v1_design", "to": "review_v1_design", "on": "completed"},
    {"from": "review_v1_design", "to": "implement_v1", "on": "completed"},
    {"from": "implement_v1", "to": "review_v1_build", "on": "completed"}
  ],
  "cycles": [
    {
      "from": "review_v1_design",
      "to": "synthesize_v1_design",
      "on_verdict": "needs_revision",
      "max_iterations": 1
    },
    {
      "from": "review_v1_build",
      "to": "implement_v1",
      "on_verdict": "needs_revision",
      "max_iterations": 1
    }
  ]
}
