{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "dogfood-021-web-chat-browse",
  "workflow_version": "2026-05-09",
  "name": "Dogfood 021: Ship RFC 0023 V1 (web chat + browse) with 3-lane review",
  "branch": {"mode": "auto", "suggested_name": "striatum/dogfood-021-web-chat-browse", "allow_dirty": false},
  "coordinator": {"role_id": "coordinator", "lane_id": "codex"},
  "harness_profiles": {
    "codex_default": {"tool_family": "codex", "strategy_version": "2026-05-09", "native_delegation": {"mode": "encouraged", "instruction": "Use sub-agents."}, "feature_flags": {"subagents": "allowed_via_natural_language_routing", "skills": "encouraged"}, "supervision": {"compatible": true, "stdin_format": "packet", "wrapper_required": false}, "approval_mode": "default", "memory_files": ["AGENTS.md"], "accountability": {"native_subagents": "internal_to_parent_session", "first_class_registration": "not_supported"}},
    "claude_code_default": {"tool_family": "claude_code", "strategy_version": "2026-05-09", "native_delegation": {"mode": "preferred", "instruction": "Spawn sub-agents."}, "feature_flags": {"subagents": "preferred", "skills": "encouraged", "headless_print_mode": "forbidden_for_supervised_lanes"}, "supervision": {"compatible": true, "stdin_format": "newline_delimited_json", "wrapper_required": true}, "approval_mode": "auto_edit", "memory_files": ["CLAUDE.md", "AGENTS.md"], "accountability": {"native_subagents": "internal_to_parent_session", "first_class_registration": "not_supported"}}
  },
  "lanes": {
    "codex": {"adapter": "process", "display_model": "Codex GPT-5.5", "command": ["codex", "exec", "--json", "--ephemeral", "--skip-git-repo-check", "--sandbox", "workspace-write", "--ask-for-approval", "never", "--ignore-user-config", "-"], "capabilities": ["write", "review", "synthesis"], "constraints": {"transcripts": "off", "repo_scope": "local_only", "network": "forbidden"}, "required_enforcement": {"transcripts": "enforced"}, "harness_profile_id": "codex_default", "env": {"CODEX_HOME": "${STRIATUM_SCRATCH_DIR}/codex-home"}},
    "claude_code": {"adapter": "process", "display_model": "Claude Opus", "command": [".striatum/bin/claude-supervised-wrapper.sh"], "capabilities": ["write", "review", "synthesis"], "constraints": {"transcripts": "off", "repo_scope": "local_only"}, "required_enforcement": {"transcripts": "enforced"}, "harness_profile_id": "claude_code_default"}
  },
  "roles": {
    "researcher": {"definition_path": "docs/dogfood/021/roles/researcher.md"},
    "designer": {"definition_path": "docs/dogfood/021/roles/designer.md"},
    "reviewer": {"definition_path": "docs/dogfood/021/roles/reviewer.md"},
    "implementer": {"definition_path": "docs/dogfood/021/roles/implementer.md"},
    "coordinator": {"definition_path": "docs/dogfood/021/roles/coordinator.md"}
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "docs/SPEC.md", "required": true},
    {"path": "docs/rfcs/0023-web-chat-and-browse.md", "required": true},
    {"path": "src/striatum/service.py", "required": false}
  ],
  "parallelism": {"mode": "declared", "max_active_jobs": 3, "require_disjoint_write_scopes": true},
  "jobs": [
    {"id": "research_chat", "type": "generic", "title": "Audit service.py routes + supervisor primitive + outbound HTTP options", "role_id": "researcher", "lane_id": "codex", "fresh_session_required": true, "objective": "Map the existing service.py route table, RFC 0009 supervisor surface, and the stdlib HTTP client paths usable for streaming SSE without adding httpx.", "task_prompt": {"path": "docs/dogfood/021/prompts/research.md"}, "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/dogfood/021/research/"], "forbidden_paths": [".striatum/"]}, "expected_artifacts": [{"logical_name": "research", "kind": "handoff", "path": "docs/dogfood/021/research/CHAT_SHAPE.md", "required": true}]},
    {"id": "synthesize_v1_design", "type": "synthesis", "title": "Lock RFC 0023 V1 design", "role_id": "designer", "lane_id": "codex", "objective": "Pin V1 scope (chat surface + Markdown rendering on artifacts; defer full file-tree browser to V1.5 if time-bounded), the two API flavors, sanitizer policy, env var contract, test plan.", "task_prompt": {"path": "docs/dogfood/021/prompts/synthesize.md"}, "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["docs/dogfood/021/"], "forbidden_paths": [".striatum/"]}, "expected_artifacts": [{"logical_name": "design", "kind": "synthesis", "path": "docs/dogfood/021/DESIGN_SYNTHESIS.md", "required": true}]},
    {"id": "review_design_security", "type": "review", "title": "Security-posture design review", "role_id": "reviewer", "lane_id": "claude_code", "fresh_session_required": true, "reviewer_access_scope": "artifact_augmented", "reviewer_context_policy": "fresh", "review_posture": "security", "objective": "Adversarially review the V1 design for security weaknesses: API key handling, SSRF, path traversal, sanitization of model output, CSP impact, transcript leakage.", "task_prompt": {"path": "docs/dogfood/021/prompts/review_design_security.md"}, "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/dogfood/021/review/design_security/"], "forbidden_paths": [".striatum/"]}, "expected_artifacts": [{"logical_name": "design_review_security", "kind": "finding", "path": "docs/dogfood/021/review/design_security/REVIEW.md", "required": true}]},
    {"id": "review_design_devils", "type": "review", "title": "Devil's-advocate design review", "role_id": "reviewer", "lane_id": "claude_code", "fresh_session_required": true, "reviewer_access_scope": "artifact_augmented", "reviewer_context_policy": "fresh", "review_posture": "devils_advocate", "objective": "Argue against V1 scope choices: too big? wrong V1.5 deferrals? wrong env-var shape? wrong default behaviors when chat is unconfigured?", "task_prompt": {"path": "docs/dogfood/021/prompts/review_design_devils.md"}, "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/dogfood/021/review/design_devils/"], "forbidden_paths": [".striatum/"]}, "expected_artifacts": [{"logical_name": "design_review_devils", "kind": "finding", "path": "docs/dogfood/021/review/design_devils/REVIEW.md", "required": true}]},
    {"id": "review_design_threat", "type": "review", "title": "Threat-model design review", "role_id": "reviewer", "lane_id": "claude_code", "fresh_session_required": true, "reviewer_access_scope": "artifact_augmented", "reviewer_context_policy": "fresh", "review_posture": "threat_model", "objective": "Enumerate trust boundaries the V1 introduces: striatum→provider, browser→striatum, model output→DOM, scratch JSONL→git tree. What gets through each boundary?", "task_prompt": {"path": "docs/dogfood/021/prompts/review_design_threat.md"}, "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/dogfood/021/review/design_threat/"], "forbidden_paths": [".striatum/"]}, "expected_artifacts": [{"logical_name": "design_review_threat", "kind": "finding", "path": "docs/dogfood/021/review/design_threat/REVIEW.md", "required": true}]},
    {"id": "implement_v1", "type": "build", "title": "Implement RFC 0023 V1", "role_id": "implementer", "lane_id": "codex", "required_review_postures": ["security", "devils_advocate", "threat_model"], "objective": "Ship the V1 scope from synthesis: chat surface (provider-neutral client, both flavors) + Markdown rendering on artifacts + minimum file-view endpoint. Per-finding implementation notes in BUILD_HANDOFF.", "task_prompt": {"path": "docs/dogfood/021/prompts/implement.md"}, "write_scope": {"mode": "repo_write", "repo_write": true, "allowed_paths": ["src/striatum/", "tests/", "docs/SPEC.md", "docs/UBIQUITOUS_LANGUAGE.md", "docs/DECISION_LOG.md", "docs/TODO.md", "docs/rfcs/0023-web-chat-and-browse.md", "docs/rfcs/README.md", "docs/dogfood/021/", "docs/dogfood/FRICTION_LOG.md", "docs/HOW_TO_HUMAN.md", "docs/HOW_TO_AGENT.md", "docs/CLI_REFERENCE.md", "examples/", "README.md", "CHANGELOG.md", "pyproject.toml"], "forbidden_paths": [".striatum/state.sqlite3"]}, "expected_artifacts": [{"logical_name": "build_handoff", "kind": "handoff", "path": "docs/dogfood/021/BUILD_HANDOFF.md", "required": true}]},
    {"id": "review_build_security", "type": "review", "title": "Security-posture build review", "role_id": "reviewer", "lane_id": "claude_code", "fresh_session_required": true, "reviewer_access_scope": "repo_level", "reviewer_context_policy": "fresh", "review_posture": "security", "objective": "Verify the build addressed Security findings: API key handling, sanitizer policy enforced, no path-traversal, no SSRF surface, CSP unchanged.", "task_prompt": {"path": "docs/dogfood/021/prompts/review_build_security.md"}, "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/dogfood/021/review/build_security/"], "forbidden_paths": [".striatum/"]}, "expected_artifacts": [{"logical_name": "build_review_security", "kind": "finding", "path": "docs/dogfood/021/review/build_security/REVIEW.md", "required": true}]},
    {"id": "review_build_devils", "type": "review", "title": "Devil's-advocate build review", "role_id": "reviewer", "lane_id": "claude_code", "fresh_session_required": true, "reviewer_access_scope": "repo_level", "reviewer_context_policy": "fresh", "review_posture": "devils_advocate", "objective": "Argue against the build: was scope creep avoided? are V1.5 deferrals honest? does the implementation match the synthesis?", "task_prompt": {"path": "docs/dogfood/021/prompts/review_build_devils.md"}, "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/dogfood/021/review/build_devils/"], "forbidden_paths": [".striatum/"]}, "expected_artifacts": [{"logical_name": "build_review_devils", "kind": "finding", "path": "docs/dogfood/021/review/build_devils/REVIEW.md", "required": true}]},
    {"id": "review_build_ergonomics", "type": "review", "title": "Ergonomics-DX build review", "role_id": "reviewer", "lane_id": "claude_code", "fresh_session_required": true, "reviewer_access_scope": "repo_level", "reviewer_context_policy": "fresh", "review_posture": "ergonomics_dx", "objective": "Evaluate first-time-operator experience: clear errors when chat unconfigured, sensible defaults, intuitive nav, dark-mode parity, mobile-or-not honest.", "task_prompt": {"path": "docs/dogfood/021/prompts/review_build_ergonomics.md"}, "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/dogfood/021/review/build_ergonomics/"], "forbidden_paths": [".striatum/"]}, "expected_artifacts": [{"logical_name": "build_review_ergonomics", "kind": "finding", "path": "docs/dogfood/021/review/build_ergonomics/REVIEW.md", "required": true}]}
  ],
  "edges": [
    {"from": "research_chat", "to": "synthesize_v1_design", "on": "completed"},
    {"from": "synthesize_v1_design", "to": "review_design_security", "on": "completed"},
    {"from": "synthesize_v1_design", "to": "review_design_devils", "on": "completed"},
    {"from": "synthesize_v1_design", "to": "review_design_threat", "on": "completed"},
    {"from": "review_design_security", "to": "implement_v1", "on": "completed"},
    {"from": "review_design_devils", "to": "implement_v1", "on": "completed"},
    {"from": "review_design_threat", "to": "implement_v1", "on": "completed"},
    {"from": "implement_v1", "to": "review_build_security", "on": "completed"},
    {"from": "implement_v1", "to": "review_build_devils", "on": "completed"},
    {"from": "implement_v1", "to": "review_build_ergonomics", "on": "completed"}
  ],
  "cycles": [
    {"from": "review_design_security", "to": "synthesize_v1_design", "on_verdict": "needs_revision", "max_iterations": 1},
    {"from": "review_design_devils", "to": "synthesize_v1_design", "on_verdict": "needs_revision", "max_iterations": 1},
    {"from": "review_design_threat", "to": "synthesize_v1_design", "on_verdict": "needs_revision", "max_iterations": 1},
    {"from": "review_build_security", "to": "implement_v1", "on_verdict": "needs_revision", "max_iterations": 1},
    {"from": "review_build_devils", "to": "implement_v1", "on_verdict": "needs_revision", "max_iterations": 1},
    {"from": "review_build_ergonomics", "to": "implement_v1", "on_verdict": "needs_revision", "max_iterations": 1}
  ]
}
