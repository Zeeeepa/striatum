{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "dogfood-004-claude-supervised-wrapper",
  "workflow_version": "2026-05-08",
  "name": "Dogfood 004: Author the Claude Code supervised wrapper",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/dogfood-004-claude-supervised-wrapper",
    "allow_dirty": false
  },
  "coordinator": {
    "role_id": "coordinator",
    "lane_id": "codex"
  },
  "harness_profiles": {
    "codex_default": {
      "tool_family": "codex",
      "strategy_version": "2026-05-08",
      "native_delegation": {
        "mode": "encouraged",
        "instruction": "Use sub-agents by routing the parent prompt; ship .codex/agents/<role>.toml definitions. Spawn parallel codex exec instances ONLY when each has its own CODEX_HOME and --ephemeral, otherwise session state corrupts (openai/codex#11435).",
        "max_parallel_native_agents": "tool_default"
      },
      "feature_flags": {
        "subagents": "allowed_via_natural_language_routing",
        "agent_teams": "not_supported",
        "skills": "encouraged",
        "custom_agent_roles": "allowed",
        "hooks": "allowed",
        "mcp": "allowed",
        "ephemeral_sessions": "required_for_parallel"
      },
      "workspace_isolation": {
        "state_dir_per_job": true,
        "rollout_persistence": "off"
      },
      "agent_loop_budget": {
        "auto_compact_limit": 280000,
        "model_reasoning_effort": "medium",
        "max_iterations": 8
      },
      "supervision": {
        "compatible": true,
        "stdin_format": "packet",
        "wrapper_required": false
      },
      "output_format": "json",
      "approval_mode": "default",
      "memory_files": ["AGENTS.md"],
      "accountability": {
        "native_subagents": "internal_to_parent_session",
        "first_class_registration": "not_supported"
      }
    },
    "claude_code_default": {
      "tool_family": "claude_code",
      "strategy_version": "2026-05-08",
      "native_delegation": {
        "mode": "preferred",
        "instruction": "Spawn the maximum number of useful sub-agents whose work is bounded, independent, and stays inside the packet write scope. Prefer specialist sub-agents (review, research, fixture inspection) over broad repo-write fan-out.",
        "max_parallel_native_agents": "tool_default"
      },
      "feature_flags": {
        "subagents": "preferred",
        "agent_teams": "allowed_experimental",
        "skills": "encouraged",
        "custom_agent_roles": "allowed",
        "hooks": "encouraged",
        "mcp": "allowed",
        "headless_print_mode": "forbidden_for_supervised_lanes"
      },
      "supervision": {
        "compatible": true,
        "stdin_format": "newline_delimited_json",
        "wrapper_required": true
      },
      "approval_mode": "auto_edit",
      "memory_files": ["CLAUDE.md", "AGENTS.md"],
      "accountability": {
        "native_subagents": "internal_to_parent_session",
        "first_class_registration": "not_supported"
      }
    }
  },
  "lanes": {
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5",
      "command": [
        "codex", "exec", "--json", "--ephemeral",
        "--skip-git-repo-check",
        "--sandbox", "workspace-write",
        "--ask-for-approval", "never",
        "--ignore-user-config", "-"
      ],
      "capabilities": ["write", "review", "synthesis"],
      "constraints": {
        "transcripts": "off",
        "repo_scope": "local_only",
        "network": "forbidden"
      },
      "required_enforcement": {
        "transcripts": "enforced"
      },
      "harness_profile_id": "codex_default",
      "env": {
        "CODEX_HOME": "${STRIATUM_SCRATCH_DIR}/codex-home"
      }
    },
    "claude_code": {
      "adapter": "process",
      "display_model": "Claude Opus",
      "command": [".striatum/bin/claude-supervised-wrapper.sh"],
      "capabilities": ["write", "review", "synthesis"],
      "constraints": {
        "transcripts": "off",
        "repo_scope": "local_only"
      },
      "required_enforcement": {
        "transcripts": "enforced"
      },
      "harness_profile_id": "claude_code_default"
    }
  },
  "roles": {
    "researcher": {
      "definition_path": "docs/dogfood/004/roles/researcher.md"
    },
    "designer": {
      "definition_path": "docs/dogfood/004/roles/designer.md"
    },
    "reviewer": {
      "definition_path": "docs/dogfood/004/roles/reviewer.md"
    },
    "implementer": {
      "definition_path": "docs/dogfood/004/roles/implementer.md"
    },
    "coordinator": {
      "definition_path": "docs/dogfood/004/roles/coordinator.md"
    }
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "README.md", "required": true},
    {"path": "docs/SPEC.md", "required": true},
    {"path": "docs/DECISION_LOG.md", "required": true},
    {"path": "docs/rfcs/0009-long-lived-process-supervision.md", "required": true},
    {"path": "docs/rfcs/0010-tool-harness-profiles.md", "required": true},
    {"path": "docs/dogfood/003/findings/HARNESS-001.md", "required": true},
    {"path": "docs/dogfood/003/research/claude_code/TOOL_RESEARCH.md", "required": true},
    {"path": "docs/dogfood/004/SOURCES.md", "required": true},
    {"path": "src/striatum/cli/supervise.py", "required": false},
    {"path": "src/striatum/process_adapter.py", "required": false},
    {"path": "tests/test_supervise.py", "required": false}
  ],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 1,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "research_pipe_behavior",
      "type": "generic",
      "title": "Research Claude Code stdin behavior under named pipes",
      "role_id": "researcher",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Determine which Claude Code invocation form supports long-lived stdin streaming under os.mkfifo, and document the line-buffering, EOF, and back-pressure semantics that the wrapper must rely on.",
      "task_prompt": {
        "path": "docs/dogfood/004/prompts/research_pipe.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/dogfood/004/research/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "pipe_research",
          "kind": "handoff",
          "path": "docs/dogfood/004/research/PIPE_BEHAVIOR.md",
          "required": true
        }
      ]
    },
    {
      "id": "synthesize_wrapper_design",
      "type": "synthesis",
      "title": "Design the Claude Code supervised wrapper script",
      "role_id": "designer",
      "lane_id": "codex",
      "objective": "Produce an implementation-ready design for .striatum/bin/claude-supervised-wrapper.sh and the verification test that proves named-pipe behavior under the supervisor's stdin.",
      "task_prompt": {
        "path": "docs/dogfood/004/prompts/synthesize_wrapper.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/dogfood/004/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "wrapper_design",
          "kind": "synthesis",
          "path": "docs/dogfood/004/DESIGN_SYNTHESIS.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_wrapper_design",
      "type": "review",
      "title": "Review the wrapper design synthesis",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "fresh_session_required": true,
      "reviewer_access_scope": "artifact_augmented",
      "reviewer_context_policy": "fresh",
      "objective": "Review the wrapper design for correctness, safety under named-pipe stdin, no-transcript posture, and minimum-viable scope.",
      "task_prompt": {
        "path": "docs/dogfood/004/prompts/review_wrapper_design.md"
      },
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": [
          "docs/dogfood/004/review/design/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "wrapper_design_review",
          "kind": "finding",
          "path": "docs/dogfood/004/review/design/DESIGN_REVIEW.md",
          "required": true
        }
      ]
    },
    {
      "id": "implement_wrapper",
      "type": "build",
      "title": "Implement the Claude Code supervised wrapper",
      "role_id": "implementer",
      "lane_id": "codex",
      "objective": "After human acceptance is recorded, ship .striatum/bin/claude-supervised-wrapper.sh, the verification test, the install/permissions story, and the docs needed to use it.",
      "task_prompt": {
        "path": "docs/dogfood/004/prompts/implement_wrapper.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "src/striatum/",
          "tests/",
          "scripts/",
          "docs/SPEC.md",
          "docs/UBIQUITOUS_LANGUAGE.md",
          "docs/rfcs/0010-tool-harness-profiles.md",
          "docs/rfcs/0009-long-lived-process-supervision.md",
          "docs/dogfood/004/",
          "README.md",
          "CHANGELOG.md",
          ".striatum/bin/"
        ],
        "forbidden_paths": [
          ".striatum/state.sqlite3"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "wrapper_handoff",
          "kind": "handoff",
          "path": "docs/dogfood/004/BUILD_HANDOFF.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_wrapper_build",
      "type": "review",
      "title": "Review the wrapper implementation",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "fresh_session_required": true,
      "reviewer_access_scope": "repo_level",
      "reviewer_context_policy": "fresh",
      "objective": "Review the wrapper implementation for correctness, supervisor-contract compliance, transcript posture, and test coverage of the named-pipe behavior.",
      "task_prompt": {
        "path": "docs/dogfood/004/prompts/review_wrapper_build.md"
      },
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": [
          "docs/dogfood/004/review/build/"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "wrapper_build_review",
          "kind": "finding",
          "path": "docs/dogfood/004/review/build/BUILD_REVIEW.md",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {"from": "research_pipe_behavior", "to": "synthesize_wrapper_design", "on": "completed"},
    {"from": "synthesize_wrapper_design", "to": "review_wrapper_design", "on": "completed"},
    {"from": "review_wrapper_design", "to": "implement_wrapper", "on": "completed"},
    {"from": "implement_wrapper", "to": "review_wrapper_build", "on": "completed"}
  ],
  "cycles": [
    {
      "from": "review_wrapper_design",
      "to": "synthesize_wrapper_design",
      "on_verdict": "needs_revision",
      "max_iterations": 1
    },
    {
      "from": "review_wrapper_build",
      "to": "implement_wrapper",
      "on_verdict": "needs_revision",
      "max_iterations": 1
    }
  ]
}
