  "jobs": [
    {
      "id": "design_codex",
      "type": "generic",
      "title": "Design RFC 0033 substrate from Codex",
      "role_id": "designer",
      "lane_id": "codex",
      "parallel_group": "fresh_design",
      "fresh_session_required": true,
      "objective": "Produce an implementation design for the RFC 0033 storage substrate rewrite for daemon V2. Cover schema migration model, audit-chain mapping, V1 SQLite → V2 Postgres cutover, daemon doctor verification, test infrastructure, and risk surfacing for the system-Postgres requirement.",
      "task_prompt": {"path": "docs/dogfood/033/prompts/design_codex.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": ["docs/dogfood/033/design/codex/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "codex_design",
          "kind": "handoff",
          "path": "docs/dogfood/033/design/codex/DESIGN.md",
          "required": true
        }
      ]
    },
    {
      "id": "design_claude_code",
      "type": "generic",
      "title": "Design RFC 0033 substrate from Claude Code",
      "role_id": "designer",
      "lane_id": "claude_code",
      "parallel_group": "fresh_design",
      "fresh_session_required": true,
      "objective": "Produce an implementation design for the RFC 0033 storage substrate rewrite. Emphasize trust boundaries (daemon-owned schema, role-enforced append-only audit), schema/migration honesty (forward-only, no down migrations), operator onboarding UX for system Postgres, and integration with the existing V1 daemon registry SQLite for cutover.",
      "task_prompt": {"path": "docs/dogfood/033/prompts/design_claude_code.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": ["docs/dogfood/033/design/claude_code/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "claude_code_design",
          "kind": "handoff",
          "path": "docs/dogfood/033/design/claude_code/DESIGN.md",
          "required": true
        }
      ]
    },
    {
      "id": "design_gemini",
      "type": "generic",
      "title": "Design RFC 0033 substrate from Gemini",
      "role_id": "designer",
      "lane_id": "gemini",
      "parallel_group": "fresh_design",
      "fresh_session_required": true,
      "objective": "Produce an implementation design for the RFC 0033 storage substrate rewrite. Emphasize cross-platform reality (macOS, Linux, Windows-via-WSL operator install paths for system Postgres), packaging/distribution implications, daemon doctor onboarding hints, and operational lifecycle (PG version drift, role privileges, connection pooling).",
      "task_prompt": {"path": "docs/dogfood/033/prompts/design_gemini.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": ["docs/dogfood/033/design/gemini/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "gemini_design",
          "kind": "handoff",
          "path": "docs/dogfood/033/design/gemini/DESIGN.md",
          "required": true
        }
      ]
    },
    {
      "id": "synthesize_design",
      "type": "synthesis",
      "title": "Synthesize RFC 0033 substrate implementation plan",
      "role_id": "designer",
      "lane_id": "codex",
      "objective": "Reconcile all three fresh design artifacts into one implementation plan for RFC 0033. Pick concrete schema layout, migration ordering, audit-chain Postgres mapping, V1 cutover UX, test harness shape, and document the system-Postgres operator onboarding story. Make deferrals explicit (bundled/Dockerized distribution, signing-key migration, etc.).",
      "task_prompt": {"path": "docs/dogfood/033/prompts/synthesize_design.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": ["docs/dogfood/033/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "design_synthesis",
          "kind": "synthesis",
          "path": "docs/dogfood/033/DESIGN_SYNTHESIS.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_design_threat",
      "type": "review",
      "title": "Threat-model review of RFC 0033 substrate design",
      "role_id": "reviewer",
      "lane_id": "gemini",
      "fresh_session_required": true,
      "reviewer_access_scope": "artifact_augmented",
      "reviewer_context_policy": "fresh",
      "review_posture": "threat_model",
      "objective": "Review the synthesized substrate plan against explicit threat boundaries: daemon-to-Postgres trust, role-privilege escalation paths, schema/user-version tamper, audit-chain integrity across migration, V1→V2 cutover correctness, cross-platform PG version drift, and operator onboarding errors that produce data-loss footguns. Scope is over-eager AI agents and operator mistakes; per RFC 0031 threat model, malicious-local-root is out of scope.",
      "task_prompt": {"path": "docs/dogfood/033/prompts/review_design.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["docs/dogfood/033/review/design/threat/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "design_review_threat",
          "kind": "finding",
          "path": "docs/dogfood/033/review/design/threat/REVIEW.md",
          "required": true
        }
      ]
    },
    {
      "id": "implement",
      "type": "build",
      "title": "Implement RFC 0033 substrate V2 slice",
      "role_id": "implementer",
      "lane_id": "codex",
      "required_review_postures": ["threat_model"],
      "objective": "Implement only the reviewed and accepted RFC 0033 V2 slice from docs/dogfood/033/DESIGN_SYNTHESIS.md. This job is blocked until review_design_threat returns an accepting verdict. Devil's-advocate and security reviews are deliberately post-implementation (operator decision) and not gated by this dogfood; the implementation must still pass make lint/typecheck/test/smoke.",
      "task_prompt": {"path": "docs/dogfood/033/prompts/implement.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "src/striatum/",
          "tests/",
          "docs/SPEC.md",
          "docs/UBIQUITOUS_LANGUAGE.md",
          "docs/DECISION_LOG.md",
          "docs/TODO.md",
          "docs/MCP.md",
          "docs/CLI_REFERENCE.md",
          "docs/HOW_TO_HUMAN.md",
          "docs/rfcs/0033-storage-substrate-rewrite-for-daemon-v2.md",
          "docs/rfcs/README.md",
          "docs/dogfood/033/",
          "README.md",
          "CHANGELOG.md",
          "pyproject.toml"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "build_handoff",
          "kind": "handoff",
          "path": "docs/dogfood/033/BUILD_HANDOFF.md",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {"from": "design_codex", "to": "synthesize_design", "on": "completed"},
    {"from": "design_claude_code", "to": "synthesize_design", "on": "completed"},
