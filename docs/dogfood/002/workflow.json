{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "dogfood-002-rfc-0011-session-close",
  "workflow_version": "2026-05-08",
  "name": "Dogfood 002: Land RFC 0011 (session close + run-terminal auto-close)",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/dogfood-002-session-close",
    "allow_dirty": false
  },
  "coordinator": {
    "role_id": "coordinator",
    "lane_id": "claude_code"
  },
  "lanes": {
    "claude_code": {
      "adapter": "process",
      "display_model": "Claude Opus",
      "command": ["claude", "--model", "opus", "-p"],
      "capabilities": ["write", "review"],
      "constraints": {
        "transcripts": "off",
        "repo_scope": "local_only"
      },
      "required_enforcement": {
        "transcripts": "enforced"
      }
    },
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5",
      "command": ["codex", "exec", "-"],
      "capabilities": ["write", "review"],
      "constraints": {
        "transcripts": "off",
        "repo_scope": "local_only"
      },
      "required_enforcement": {
        "transcripts": "enforced"
      }
    }
  },
  "roles": {
    "author": {"definition_path": "docs/dogfood/002/roles/author.md"},
    "reviewer": {"definition_path": "docs/dogfood/002/roles/reviewer.md"},
    "coordinator": {"definition_path": "docs/dogfood/002/roles/coordinator.md"}
  },
  "context_docs": [
    {"path": "AGENTS.md", "required": true},
    {"path": "docs/SPEC.md", "required": true},
    {"path": "docs/rfcs/0011-session-close-and-run-terminal-auto-close.md", "required": true},
    {"path": "src/striatum/cli/mutations.py", "required": false},
    {"path": "src/striatum/cli/introspect.py", "required": false},
    {"path": "src/striatum/cli/parser.py", "required": false},
    {"path": "src/striatum/cli/dispatch.py", "required": false},
    {"path": "src/striatum/cli/evidence.py", "required": false},
    {"path": "src/striatum/cli/run_summary.py", "required": false},
    {"path": "src/striatum/migrations.py", "required": false},
    {"path": "tests/test_harness_v2_fixes.py", "required": false}
  ],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 1,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "draft_change",
      "type": "draft",
      "title": "Implement RFC 0011: session close + run-terminal auto-close",
      "role_id": "author",
      "lane_id": "claude_code",
      "objective": "Land the explicit `striatum session close` command, the run-terminal auto-close helper, schema migration version 7, evidence/run-summary rendering of closed sessions, and the seven RFC-0011 acceptance tests.",
      "task_prompt": {"path": "docs/dogfood/002/prompts/draft.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "src/striatum/",
          "tests/",
          "docs/SPEC.md",
          "docs/UBIQUITOUS_LANGUAGE.md",
          "docs/DECISION_LOG.md",
          "docs/dogfood/002/",
          "docs/rfcs/",
          "README.md",
          "CHANGELOG.md"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "draft_handoff",
          "kind": "handoff",
          "path": "docs/dogfood/002/DRAFT_HANDOFF.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_change",
      "type": "review",
      "title": "Independent review of RFC 0011 implementation",
      "role_id": "reviewer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "reviewer_access_scope": "artifact_augmented",
      "reviewer_context_policy": "fresh",
      "objective": "Verify each RFC 0011 acceptance criterion against the landed code: explicit close, idempotency, lease refusal, auto-close on each terminal transition, doctor warning resolution, evidence rendering. Walk all seven prescribed tests.",
      "task_prompt": {"path": "docs/dogfood/002/prompts/review.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["docs/dogfood/002/review/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review_finding",
          "kind": "finding",
          "path": "docs/dogfood/002/review/FINDING.md",
          "required": true
        }
      ]
    },
    {
      "id": "apply_change",
      "type": "synthesis",
      "title": "Apply accepted review and finalize RFC 0011",
      "role_id": "author",
      "lane_id": "claude_code",
      "objective": "Apply accepted review findings, mark RFC 0011 accepted, add the DECISION_LOG entry, run make lint typecheck test, and write a final summary handoff.",
      "task_prompt": {"path": "docs/dogfood/002/prompts/apply.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "src/striatum/",
          "tests/",
          "docs/SPEC.md",
          "docs/UBIQUITOUS_LANGUAGE.md",
          "docs/DECISION_LOG.md",
          "docs/dogfood/002/",
          "docs/rfcs/",
          "README.md",
          "CHANGELOG.md"
        ],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "apply_handoff",
          "kind": "handoff",
          "path": "docs/dogfood/002/APPLY_HANDOFF.md",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {"from": "draft_change", "to": "review_change", "on": "completed"},
    {"from": "review_change", "to": "apply_change", "on": "completed"}
  ],
  "cycles": [
    {
      "from": "review_change",
      "to": "draft_change",
      "on_verdict": "needs_revision",
      "max_iterations": 1
    }
  ]
}
