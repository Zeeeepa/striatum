{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "rfc-0089-tmux-final-build-review",
  "workflow_version": "2026-05-28",
  "name": "RFC 0089 final Codex build and three-lane interrogating review",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/rfc-0089-tmux-final-build-review",
    "allow_dirty": true
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "claude_code"},
  "lanes": {
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5 xhigh",
      "command": ["codex", "--model", "gpt-5.5", "-c", "model_reasoning_effort=\"xhigh\"", "--dangerously-bypass-approvals-and-sandbox"],
      "adapter_capabilities": {"agent_loop": true},
      "capabilities": ["write", "review", "synthesis", "interrogate"]
    },
    "codex_builder": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5 xhigh",
      "command": ["codex", "--model", "gpt-5.5", "-c", "model_reasoning_effort=\"xhigh\"", "--dangerously-bypass-approvals-and-sandbox"],
      "adapter_capabilities": {"agent_loop": true},
      "capabilities": ["write", "interrogate"]
    },
    "claude_code": {
      "adapter": "process",
      "display_model": "Claude Opus 4.7",
      "command": ["claude", "--model", "claude-opus-4-7", "--permission-mode", "bypassPermissions"],
      "adapter_capabilities": {"agent_loop": true},
      "capabilities": ["write", "review", "synthesis", "interrogate"]
    },
    "agy": {
      "adapter": "process",
      "display_model": "Gemini 3.5 Flash High",
      "command": ["sh", "-c", "prompt=$(timeout 60s cat || true); exec agy --dangerously-skip-permissions --print-timeout 30m --print \"$prompt\" </dev/null"],
      "supervision": {"transport": "pipe", "stdin_delivery": "one_shot_eof"},
      "capabilities": ["write", "review", "interrogate"]
    }
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "reviewer": {"definition_path": "roles/reviewer.md"}
  },
  "context_docs": [
    {"path": "docs/operator/workflows/rfc-0089-tmux-final-build-review/TASK.md", "required": true},
    {"path": "docs/rfcs/0089-tmux-backed-lane-monitoring.md", "required": true},
    {"path": "docs/operator/workflows/rfc-0089-tmux-helper-redesign-rerun2/artifacts/DESIGN_SYNTHESIS.md", "required": true},
    {"path": "docs/operator/workflows/rfc-0089-tmux-helper-redesign-rerun2/artifacts/review/build/codex/REVIEW.md", "required": true},
    {"path": "docs/operator/workflows/rfc-0089-tmux-helper-redesign-rerun2/artifacts/review/build/agy/REVIEW.md", "required": true},
    {"path": "docs/operator/workflows/rfc-0089-tmux-helper-redesign-rerun2/artifacts/review/build/claude_code/REVIEW.md", "required": true}
  ],
  "parallelism": {"mode": "declared", "max_active_jobs": 3, "require_disjoint_write_scopes": true},
  "jobs": [
    {
      "id": "implement_final",
      "type": "build",
      "title": "Final RFC 0089 implementation pass (codex GPT-5.5 xhigh)",
      "role_id": "implementer",
      "lane_id": "codex_builder",
      "fresh_session_required": true,
      "interrogable": true,
      "required_review_postures": ["threat_model", "ergonomics_dx", "devils_advocate"],
      "objective": "Inspect and finalize the RFC 0089 implementation. Keep changes focused and stay live for the three-lane interrogation panel.",
      "task_prompt": {"path": "prompts/implement.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "go/",
          "docs/rfcs/0089-tmux-backed-lane-monitoring.md",
          "docs/reference/spec.md",
          "docs/reference/ubiquitous-language.md",
          "docs/reference/command-authority-matrix.md",
          "docs/operator/workflows/rfc-0089-tmux-final-build-review/artifacts/build/"
        ],
        "forbidden_paths": [
          ".striatum/",
          "docs/operator/workflows/rfc-0089-tmux-final-build-review/artifacts/review/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "build_handoff",
          "kind": "handoff",
          "path": "docs/operator/workflows/rfc-0089-tmux-final-build-review/artifacts/build/HANDOFF.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_build_codex",
      "type": "review",
      "title": "Final build review codex threat_model",
      "role_id": "reviewer",
      "lane_id": "codex",
      "parallel_group": "build_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "reviewer_access_scope": "repo_level",
      "review_posture": "threat_model",
      "objective": "Threat-model the final implementation and interrogate the live Codex builder before a verdict. Log the curated interrogation chat.",
      "task_prompt": {"path": "prompts/review_build.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/rfc-0089-tmux-final-build-review/artifacts/review/build/codex/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [
        {"logical_name": "build_review_codex", "kind": "finding", "path": "docs/operator/workflows/rfc-0089-tmux-final-build-review/artifacts/review/build/codex/REVIEW.md", "required": true},
        {"logical_name": "build_interrogation_chat_codex", "kind": "handoff", "path": "docs/operator/workflows/rfc-0089-tmux-final-build-review/artifacts/review/build/codex/INTERROGATION_CHAT.md", "required": true}
      ]
    },
    {
      "id": "review_build_claude",
      "type": "review",
      "title": "Final build review claude ergonomics_dx",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "parallel_group": "build_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "reviewer_access_scope": "repo_level",
      "review_posture": "ergonomics_dx",
      "objective": "Review final implementation ergonomics and interrogate the live Codex builder before a verdict. Log the curated interrogation chat.",
      "task_prompt": {"path": "prompts/review_build.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/rfc-0089-tmux-final-build-review/artifacts/review/build/claude_code/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [
        {"logical_name": "build_review_claude", "kind": "finding", "path": "docs/operator/workflows/rfc-0089-tmux-final-build-review/artifacts/review/build/claude_code/REVIEW.md", "required": true},
        {"logical_name": "build_interrogation_chat_claude", "kind": "handoff", "path": "docs/operator/workflows/rfc-0089-tmux-final-build-review/artifacts/review/build/claude_code/INTERROGATION_CHAT.md", "required": true}
      ]
    },
    {
      "id": "review_build_agy",
      "type": "review",
      "title": "Final build review agy devils_advocate",
      "role_id": "reviewer",
      "lane_id": "agy",
      "parallel_group": "build_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "reviewer_access_scope": "repo_level",
      "review_posture": "devils_advocate",
      "objective": "Adversarially review the final implementation and interrogate the live Codex builder before a verdict. Log the curated interrogation chat.",
      "task_prompt": {"path": "prompts/review_build_agy.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/rfc-0089-tmux-final-build-review/artifacts/review/build/agy/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [
        {"logical_name": "build_review_agy", "kind": "finding", "path": "docs/operator/workflows/rfc-0089-tmux-final-build-review/artifacts/review/build/agy/REVIEW.md", "required": true},
        {"logical_name": "build_interrogation_chat_agy", "kind": "handoff", "path": "docs/operator/workflows/rfc-0089-tmux-final-build-review/artifacts/review/build/agy/INTERROGATION_CHAT.md", "required": true}
      ]
    }
  ],
  "edges": [
    {"from": "implement_final", "to": "review_build_codex", "on": "completed"},
    {"from": "implement_final", "to": "review_build_claude", "on": "completed"},
    {"from": "implement_final", "to": "review_build_agy", "on": "completed"}
  ],
  "cycles": [
    {"from": "review_build_codex", "to": "implement_final", "on_verdict": "needs_revision", "max_iterations": 1, "allow_same_lane": true},
    {"from": "review_build_claude", "to": "implement_final", "on_verdict": "needs_revision", "max_iterations": 1, "allow_same_lane": true},
    {"from": "review_build_agy", "to": "implement_final", "on_verdict": "needs_revision", "max_iterations": 1, "allow_same_lane": true}
  ]
}
