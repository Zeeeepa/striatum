{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "rfc-0093-implementation",
  "workflow_version": "2026-05-29",
  "name": "RFC 0093 implementation — build V1 from preserved synthesis (build panel)",
  "branch": {
    "mode": "auto",
    "suggested_name": "striatum/rfc-0093-implementation",
    "allow_dirty": true
  },
  "coordinator": {"role_id": "coordinator", "lane_id": "claude_code"},
  "allow_same_model_review_pairing": true,
  "lanes": {
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5 xhigh",
      "command": ["codex", "--model", "gpt-5.5", "-c", "model_reasoning_effort=\"xhigh\"", "--dangerously-bypass-approvals-and-sandbox"],
      "adapter_capabilities": {"agent_loop": true},
      "capabilities": ["write", "review", "synthesis", "interrogate"]
    },
    "claude_code": {
      "adapter": "process",
      "display_model": "Claude Opus 4.7",
      "command": ["claude", "--model", "claude-opus-4-7", "--permission-mode", "bypassPermissions"],
      "adapter_capabilities": {"agent_loop": true},
      "capabilities": ["write", "review", "synthesis", "interrogate"]
    },
    "agy": {
      "adapter": "process",
      "display_model": "Gemini 3.5 Flash High",
      "command": ["agy", "--dangerously-skip-permissions"],
      "adapter_capabilities": {"agent_loop": true},
      "capabilities": ["write", "review"]
    }
  },
  "roles": {
    "coordinator": {"definition_path": "roles/coordinator.md"},
    "implementer": {"definition_path": "roles/implementer.md"},
    "reviewer": {"definition_path": "roles/reviewer.md"}
  },
  "context_docs": [
    {"path": "docs/operator/workflows/rfc-0093-collaboration-shapes/TASK.md", "required": true},
    {"path": "docs/operator/workflows/rfc-0093-collaboration-shapes/artifacts/DESIGN_SYNTHESIS.md", "required": true},
    {"path": "docs/operator/workflows/rfc-0093-collaboration-shapes/artifacts/DIALOGUE_TRAJECTORY.jsonl", "required": false},
    {"path": "docs/rfcs/0093-structured-live-collaboration-workflow-shapes.md", "required": true}
  ],
  "parallelism": {"mode": "declared", "max_active_jobs": 3, "require_disjoint_write_scopes": true},
  "jobs": [
    {
      "id": "implement",
      "type": "build",
      "title": "Implement RFC 0093 V1 (interrogable)",
      "role_id": "implementer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "interrogable": true,
      "required_review_postures": ["threat_model", "ergonomics_dx", "devils_advocate"],
      "objective": "Implement RFC 0093 V1 per artifacts/DESIGN_SYNTHESIS.md, slices 1, 3, and 4 (slice 2 — the cycle router — already landed via GH #63). Slice 1: collaboration_ledger.v1 artifact contract (front-matter schema + structural substance check Check A + review.submit verdict-consistency guard) in go/pkg/artifactcontracts + go/pkg/mutations. Slice 3: adjudicator role file + a hand-authored phase_synthesis substance-gate fixture + the anti-theater test (seeded hollow ledger -> needs_revision/refused; landed-challenge ledger -> clears). Slice 4: workflow generator shape catalog entries falsification_gate + cross_examination + the scribe participant modifier, plus docs (workflow-types, ubiquitous-language, spec) and the RFC 0083 catalog re-expression. Defer fog_of_war_review, synaptic_prune, and any post_dialog_hook. Land only convergent, tested changes; keep each slice green. Write the handoff and stay live for the build panel. Fold in the gate-semantics pin-down from the interrogation transcript (Check A in artifactcontracts vs Check B trajectory-resolution; Check B may be deferred per the synthesis if scoped).",
      "task_prompt": {"path": "prompts/implement.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "go/",
          "examples/",
          "docs/reference/workflow-types.md",
          "docs/reference/ubiquitous-language.md",
          "docs/reference/spec.md",
          "docs/agents/",
          "docs/rfcs/0093-structured-live-collaboration-workflow-shapes.md",
          "docs/rfcs/0083-iterated-panel-review-with-interrogation.md",
          "docs/operator/workflows/rfc-0093-collaboration-shapes/artifacts/build/"
        ],
        "forbidden_paths": [
          ".striatum/",
          "docs/operator/workflows/rfc-0093-collaboration-shapes/artifacts/review/"
        ]
      },
      "expected_artifacts": [{"logical_name": "build_handoff", "kind": "handoff", "path": "docs/operator/workflows/rfc-0093-collaboration-shapes/artifacts/build/HANDOFF.md", "required": true}]
    },
    {
      "id": "review_build_codex",
      "type": "review",
      "title": "Build review codex threat_model",
      "role_id": "reviewer",
      "lane_id": "codex",
      "parallel_group": "build_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "reviewer_access_scope": "repo_level",
      "review_posture": "threat_model",
      "objective": "Threat-model the RFC 0093 V1 implementation, run the verification commands (make -C go check; go test with pgtest DSN; workflow validate on new fixtures), and interrogate the live implementer before a verdict.",
      "task_prompt": {"path": "prompts/review_build.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/rfc-0093-collaboration-shapes/artifacts/review/build/codex/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "build_review_codex", "kind": "finding", "path": "docs/operator/workflows/rfc-0093-collaboration-shapes/artifacts/review/build/codex/REVIEW.md", "required": true}]
    },
    {
      "id": "review_build_claude",
      "type": "review",
      "title": "Build review claude ergonomics_dx",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "parallel_group": "build_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "reviewer_access_scope": "repo_level",
      "review_posture": "ergonomics_dx",
      "objective": "Review the implementation for operator and developer ergonomics, run the verification commands, and interrogate the live implementer before a verdict.",
      "task_prompt": {"path": "prompts/review_build.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/rfc-0093-collaboration-shapes/artifacts/review/build/claude_code/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "build_review_claude", "kind": "finding", "path": "docs/operator/workflows/rfc-0093-collaboration-shapes/artifacts/review/build/claude_code/REVIEW.md", "required": true}]
    },
    {
      "id": "review_build_agy",
      "type": "review",
      "title": "Build review agy devils_advocate",
      "role_id": "reviewer",
      "lane_id": "agy",
      "parallel_group": "build_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "reviewer_access_scope": "repo_level",
      "review_posture": "devils_advocate",
      "objective": "Adversarially probe the implementation, run the verification commands, and render a verdict.",
      "task_prompt": {"path": "prompts/review_build.md"},
      "write_scope": {"mode": "review_only_artifact", "repo_write": false, "allowed_paths": ["docs/operator/workflows/rfc-0093-collaboration-shapes/artifacts/review/build/agy/"], "forbidden_paths": [".striatum/"]},
      "expected_artifacts": [{"logical_name": "build_review_agy", "kind": "finding", "path": "docs/operator/workflows/rfc-0093-collaboration-shapes/artifacts/review/build/agy/REVIEW.md", "required": true}]
    }
  ],
  "edges": [
    {"from": "implement", "to": "review_build_codex", "on": "completed"},
    {"from": "implement", "to": "review_build_claude", "on": "completed"},
    {"from": "implement", "to": "review_build_agy", "on": "completed"}
  ],
  "cycles": [
    {"from": "review_build_codex", "to": "implement", "on_verdict": "needs_revision", "max_iterations": 2, "allow_same_lane": true},
    {"from": "review_build_claude", "to": "implement", "on_verdict": "needs_revision", "max_iterations": 2, "allow_same_lane": true},
    {"from": "review_build_agy", "to": "implement", "on_verdict": "needs_revision", "max_iterations": 2, "allow_same_lane": true}
  ]
}
