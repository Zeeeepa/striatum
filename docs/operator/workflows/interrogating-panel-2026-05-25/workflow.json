        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "build_review_claude",
          "kind": "finding",
          "path": "docs/operator/workflows/interrogating-panel-2026-05-25/artifacts/review/build/claude_code/REVIEW.md",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "design_codex",
      "to": "synth",
      "on": "completed"
    },
    {
      "from": "design_claude",
      "to": "synth",
      "on": "completed"
    },
    {
      "from": "design_gemini",
      "to": "synth",
      "on": "completed"
    },
    {
      "from": "synth",
      "to": "review_design_codex",
      "on": "completed"
    },
    {
      "from": "synth",
      "to": "review_design_claude",
      "on": "completed"
    },
    {
      "from": "review_design_codex",
      "to": "implement",
      "on": "completed"
    },
    {
      "from": "review_design_claude",
      "to": "implement",
