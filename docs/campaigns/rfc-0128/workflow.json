{
  "branch": {
    "allow_dirty": false,
    "mode": "auto",
    "suggested_name": "striatum/rfc-0128-p0-crossrepo-lint"
  },
  "context_docs": [],
  "coordinator": {
    "lane_id": "agent",
    "role_id": "author"
  },
  "cycles": [
    {
      "from": "review",
      "max_iterations": 1,
      "on_verdict": "needs_revision",
      "to": "draft"
    }
  ],
  "edges": [
    {
      "from": "draft",
      "on": "completed",
      "to": "review"
    },
    {
      "from": "review",
      "on": "completed",
      "to": "apply"
    }
  ],
  "jobs": [
    {
      "expected_artifacts": [
        {
          "kind": "handoff",
          "logical_name": "draft",
          "path": "docs/campaigns/rfc-0128/artifacts/DRAFT.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "id": "draft",
      "lane_id": "agent",
      "objective": "Produce the starter artifact for this workflow.",
      "role_id": "author",
      "task_prompt": {
        "path": "prompts/draft.md"
      },
      "title": "Draft starter artifact",
      "type": "draft",
      "write_scope": {
        "allowed_paths": [
          "go/",
          "docs/rfcs/",
          "docs/decisions/",
          "docs/campaigns/rfc-0128/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "finding",
          "logical_name": "review",
          "path": "docs/campaigns/rfc-0128/artifacts/review/REVIEW.md",
          "placement": "blob_exhaust",
          "required": true
        }
      ],
      "fresh_session_required": true,
      "id": "review",
      "lane_id": "agent",
      "objective": "Review the draft and record a finding.",
      "role_id": "reviewer",
      "task_prompt": {
        "path": "prompts/review.md"
      },
      "title": "Review the draft",
      "type": "review",
      "write_scope": {
        "allowed_paths": [
          "docs/campaigns/rfc-0128/artifacts/review/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "review_only_artifact",
        "repo_write": false
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "synthesis",
          "logical_name": "summary",
          "path": "docs/campaigns/rfc-0128/artifacts/SUMMARY.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "id": "apply",
      "lane_id": "agent",
      "objective": "Apply the accepted review findings.",
      "role_id": "author",
      "task_prompt": {
        "path": "prompts/apply.md"
      },
      "title": "Apply the accepted review",
      "type": "synthesis",
      "write_scope": {
        "allowed_paths": [
          "go/",
          "docs/rfcs/",
          "docs/decisions/",
          "docs/campaigns/rfc-0128/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    }
  ],
  "lanes": {
    "agent": {
      "adapter": "process",
      "adapter_capabilities": {
        "agent_loop": true
      },
      "capabilities": [
        "write",
        "review",
        "synthesis"
      ],
      "command": [
        "claude",
        "--dangerously-skip-permissions"
      ],
      "display_model": "agent",
      "supervision": {
        "transport": "pty_helper",
        "require_tmux": true
      },
      "worktree_isolation": "per_job"
    }
  },
  "name": "rfc-0128-p0-crossrepo-lint",
  "parallelism": {
    "max_active_jobs": 1,
    "mode": "declared",
    "require_disjoint_write_scopes": true
  },
  "roles": {
    "author": {
      "definition_path": "roles/author.md"
    },
    "reviewer": {
      "definition_path": "roles/reviewer.md"
    }
  },
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "rfc-0128-p0-crossrepo-lint",
  "workflow_version": "2026-06-14",
  "allow_same_model_review_pairing": true,
  "same_model_review_pairing_rationale": "single_agent P0 implementation dogfood; the fresh-session review gate is a self-check and the operator performs the authoritative independent review before integrating to main."
}
