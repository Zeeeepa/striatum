{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "three-lane-design-build-review",
  "workflow_version": "2026-05-13",
  "name": "Three-lane design + build + review",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/three-lane-design-build-review",
    "allow_dirty": false
  },
  "coordinator": {
    "role_id": "coordinator",
    "lane_id": "codex"
  },
  "lanes": {
    "codex": {
      "adapter": "process",
      "display_model": "Codex (placeholder)",
      "command": [
        "codex",
        "exec",
        "-"
      ],
      "capabilities": [
        "write",
        "review",
        "synthesis"
      ]
    },
    "claude_code": {
      "adapter": "process",
      "display_model": "Claude Code (placeholder)",
      "command": [
        "claude",
        "--print"
      ],
      "capabilities": [
        "write",
        "review",
        "synthesis"
      ]
    },
    "gemini": {
      "adapter": "process",
      "display_model": "Gemini (placeholder)",
      "command": [
        "gemini",
        "-p"
      ],
      "capabilities": [
        "write",
        "review"
      ]
    }
  },
  "roles": {
    "coordinator": {
      "definition_path": "roles/coordinator.md"
    },
    "designer": {
      "definition_path": "roles/designer.md"
    },
    "implementer": {
      "definition_path": "roles/implementer.md"
    },
    "reviewer": {
      "definition_path": "roles/reviewer.md"
    }
  },
  "context_docs": [
    {
      "path": "README.md",
      "required": false
    }
  ],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 3,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "design_codex",
      "type": "draft",
      "title": "Design (codex lane)",
      "role_id": "designer",
      "lane_id": "codex",
      "parallel_group": "design",
      "fresh_session_required": true,
      "objective": "Produce an independent design proposal for the operator-supplied task. Keep the design within the artifact root and do not coordinate with the other design lanes.",
      "task_prompt": {
        "path": "prompts/design.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/three-lane-design-build-review/design/codex/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "codex_design",
          "kind": "handoff",
          "path": "docs/three-lane-design-build-review/design/codex/DESIGN.md",
          "required": true
        }
      ]
    },
    {
      "id": "design_claude",
      "type": "draft",
      "title": "Design (claude_code lane)",
      "role_id": "designer",
      "lane_id": "claude_code",
      "parallel_group": "design",
      "fresh_session_required": true,
      "objective": "Produce an independent design proposal for the operator-supplied task. Keep the design within the artifact root and do not coordinate with the other design lanes.",
      "task_prompt": {
        "path": "prompts/design.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/three-lane-design-build-review/design/claude_code/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "claude_design",
          "kind": "handoff",
          "path": "docs/three-lane-design-build-review/design/claude_code/DESIGN.md",
          "required": true
        }
      ]
    },
    {
      "id": "design_gemini",
      "type": "draft",
      "title": "Design (gemini lane)",
      "role_id": "designer",
      "lane_id": "gemini",
      "parallel_group": "design",
      "fresh_session_required": true,
      "objective": "Produce an independent design proposal for the operator-supplied task. Keep the design within the artifact root and do not coordinate with the other design lanes.",
      "task_prompt": {
        "path": "prompts/design.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/three-lane-design-build-review/design/gemini/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "gemini_design",
          "kind": "handoff",
          "path": "docs/three-lane-design-build-review/design/gemini/DESIGN.md",
          "required": true
        }
      ]
    },
    {
      "id": "synth",
      "type": "synthesis",
      "title": "Synthesize designs",
      "role_id": "designer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Reconcile the three design proposals into a single buildable synthesis. Cite each design and call out unresolved contradictions.",
      "task_prompt": {
        "path": "prompts/synth.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/three-lane-design-build-review/"
        ],
        "forbidden_paths": [
          ".striatum/",
          "docs/three-lane-design-build-review/design/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "synthesis",
          "kind": "synthesis",
          "path": "docs/three-lane-design-build-review/DESIGN_SYNTHESIS.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_design",
      "type": "review",
      "title": "Design review (ergonomics_dx)",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "review_posture": "ergonomics_dx",
      "objective": "Review the design synthesis for ergonomics and developer experience risks before any code is written.",
      "task_prompt": {
        "path": "prompts/review_design.md"
      },
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": [
          "docs/three-lane-design-build-review/review/design/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "design_review",
          "kind": "finding",
          "path": "docs/three-lane-design-build-review/review/design/REVIEW.md",
          "required": true
        }
      ]
    },
    {
      "id": "implement",
      "type": "build",
      "title": "Implement synthesized design",
      "role_id": "implementer",
      "lane_id": "codex",
      "required_review_postures": [
        "threat_model",
        "ergonomics_dx",
        "devils_advocate"
      ],
      "objective": "Implement the synthesized design. Land only the changes that the synthesis and design review converge on.",
      "task_prompt": {
        "path": "prompts/implement.md"
      },
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": [
          "docs/three-lane-design-build-review/build/",
          "src/",
          "tests/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "implementation",
          "kind": "handoff",
          "path": "docs/three-lane-design-build-review/build/HANDOFF.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_build_codex",
      "type": "review",
      "title": "Build review codex threat_model",
      "role_id": "reviewer",
      "lane_id": "codex",
      "parallel_group": "build_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "review_posture": "threat_model",
      "objective": "Threat-model the implementation: surface risks the build introduces.",
      "task_prompt": {
        "path": "prompts/review_build.md"
      },
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": [
          "docs/three-lane-design-build-review/review/build/codex/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "build_review_codex",
          "kind": "finding",
          "path": "docs/three-lane-design-build-review/review/build/codex/REVIEW.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_build_claude",
      "type": "review",
      "title": "Build review claude ergonomics_dx",
      "role_id": "reviewer",
      "lane_id": "claude_code",
      "parallel_group": "build_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "review_posture": "ergonomics_dx",
      "objective": "Review the implementation for operator and developer ergonomics.",
      "task_prompt": {
        "path": "prompts/review_build.md"
      },
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": [
          "docs/three-lane-design-build-review/review/build/claude_code/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "build_review_claude",
          "kind": "finding",
          "path": "docs/three-lane-design-build-review/review/build/claude_code/REVIEW.md",
          "required": true
        }
      ]
    },
    {
      "id": "review_build_gemini",
      "type": "review",
      "title": "Build review gemini adversarial",
      "role_id": "reviewer",
      "lane_id": "gemini",
      "parallel_group": "build_review",
      "fresh_session_required": true,
      "reviewer_context_policy": "fresh",
      "review_posture": "devils_advocate",
      "objective": "Adversarially probe the implementation: edge cases, regressions, and assumptions the build relies on.",
      "task_prompt": {
        "path": "prompts/review_build.md"
      },
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": [
          "docs/three-lane-design-build-review/review/build/gemini/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ]
      },
      "expected_artifacts": [
        {
          "logical_name": "build_review_gemini",
          "kind": "finding",
          "path": "docs/three-lane-design-build-review/review/build/gemini/REVIEW.md",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "design_codex",
      "to": "synth",
      "on": "completed"
    },
    {
      "from": "design_claude",
      "to": "synth",
      "on": "completed"
    },
    {
      "from": "design_gemini",
      "to": "synth",
      "on": "completed"
    },
    {
      "from": "synth",
      "to": "review_design",
      "on": "completed"
    },
    {
      "from": "review_design",
      "to": "implement",
      "on": "completed"
    },
    {
      "from": "implement",
      "to": "review_build_codex",
      "on": "completed"
    },
    {
      "from": "implement",
      "to": "review_build_claude",
      "on": "completed"
    },
    {
      "from": "implement",
      "to": "review_build_gemini",
      "on": "completed"
    }
  ],
  "cycles": [
    {
      "from": "review_design",
      "to": "synth",
      "on_verdict": "needs_revision",
      "max_iterations": 2,
      "allow_same_lane": true
    },
    {
      "from": "review_build_codex",
      "to": "implement",
      "on_verdict": "needs_revision",
      "max_iterations": 2,
      "allow_same_lane": true
    },
    {
      "from": "review_build_claude",
      "to": "implement",
      "on_verdict": "needs_revision",
      "max_iterations": 2,
      "allow_same_lane": true
    },
    {
      "from": "review_build_gemini",
      "to": "implement",
      "on_verdict": "needs_revision",
      "max_iterations": 2,
      "allow_same_lane": true
    }
  ]
}
