  "lanes": {
    "local": {
      "adapter": "process",
      "capabilities": [
        "write",
        "review"
      ],
      "command": [
        "sh",
        "-c",
        "cat \u003e/dev/null"
      ],
      "display_model": "Local Fixture"
    }
  },
  "name": "fog-of-war-review-flow",
  "parallelism": {
    "max_active_jobs": 1,
    "mode": "declared",
    "require_disjoint_write_scopes": true
  },
  "phases": [
    {
      "description": "Partition the spec into disjoint fragments; the judge alone holds the full spec",
      "id": "distribution",
      "name": "Fragment distribution",
      "synthesis_job_id": "fragment_map"
    },
    {
      "description": "Reconstructors interrogate peers to recover the constraints their fragment omitted",
      "id": "reconstruction",
      "name": "Reconstruction",
      "synthesis_job_id": "reconstruction_rollup"
    },
    {
      "description": "The full-spec judge scores reconstructed vs hallucinated vs missed and gates the proposal",
      "id": "coverage",
      "name": "Coverage gate",
      "synthesis_job_id": "coverage_gate"
    },
    {
      "description": "The proposal is withheld until the coverage gate clears (RFC 0094 §2 work-packet type sequencing)",
      "gate": {
        "until_verdict_clears": "coverage_gate",
        "withhold_packet_types": [
          "proposal"
        ]
      },
      "id": "proposal",
      "name": "Proposal",
      "synthesis_job_id": "proposal_synthesis"
    }
  ],
  "roles": {
    "coordinator": {
      "definition_path": "roles/coordinator.md"
    },
    "judge": {
      "definition_path": "roles/judge.md"
    },
    "proposer": {
      "definition_path": "roles/proposer.md"
    },
    "reconstructor": {
      "definition_path": "roles/reconstructor.md"
    }
  },
