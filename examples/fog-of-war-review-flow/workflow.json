      "id": "coverage_intake",
      "lane_id": "local",
      "objective": "Assemble the reconstruction rollup and the full spec for coverage adjudication of example fog_of_war_review topic. Do not add new constraints; stage the curated trajectory only.",
      "phase_id": "coverage",
      "role_id": "judge",
      "task_prompt": {
        "path": "prompts/fog_coverage_intake.md"
      },
      "title": "Stage coverage inputs",
