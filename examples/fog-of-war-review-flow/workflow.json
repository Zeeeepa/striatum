        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "synthesis",
          "logical_name": "proposal_synthesis",
          "path": "examples/fog-of-war-review-flow/artifacts/proposal/synthesis/FINAL_SUMMARY.md",
          "placement": "git_publication",
          "required": true
        }
