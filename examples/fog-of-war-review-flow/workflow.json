      "write_scope": {
        "allowed_paths": [
          "examples/fog-of-war-review-flow/artifacts/coverage/intake/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "collaboration_ledger",
          "logical_name": "fog_coverage_ledger_${cycle}",
          "path": "examples/fog-of-war-review-flow/artifacts/coverage/judge/COLLABORATION_LEDGER_${cycle}.md",
          "placement": "git_publication",
          "required": true
        }
      ],
      "fresh_session_required": true,
      "id": "coverage_gate",
      "lane_id": "local",
      "objective": "You alone hold the full spec for example fog_of_war_review topic. Read only the curated reconstruction trajectory and score each hidden constraint reconstructed / hallucinated / missed against your ground truth; publish the collaboration_ledger (shape fog_of_war_review) verdict. A lane that CLAIMED coverage it never reconstructed scores hallucinated/missed → needs_revision; the proposal stays withheld until this verdict clears.",
      "phase_id": "coverage",
      "role_id": "judge",
      "task_prompt": {
        "path": "prompts/fog_coverage_gate.md"
      },
      "title": "Score reconstruction coverage",
      "type": "phase_synthesis",
      "write_scope": {
        "allowed_paths": [
          "examples/fog-of-war-review-flow/artifacts/coverage/judge/"
        ],
        "forbidden_paths": [
          ".striatum/"
        ],
        "mode": "repo_write",
        "repo_write": true
      }
    },
    {
      "expected_artifacts": [
        {
          "kind": "handoff",
          "logical_name": "proposal",
          "path": "examples/fog-of-war-review-flow/artifacts/proposal/draft/PROPOSAL.md",
          "placement": "git_publication",
          "required": true
