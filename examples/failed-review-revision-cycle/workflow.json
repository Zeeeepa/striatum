{
  "schema_version": "striatum.workflow.v1",
  "workflow_id": "failed-review-revision-cycle",
  "workflow_version": "2026-05-07",
  "name": "Failed Review Revision Cycle",
  "branch": {
    "mode": "confirm",
    "suggested_name": "striatum/failed-review-revision-cycle",
    "allow_dirty": false
  },
  "coordinator": {
    "role_id": "author",
    "lane_id": "codex"
  },
  "review_revision_policy": {
    "root_review_needs_revision": "human_checkpoint",
    "description": "When the bounded revision cycle is exhausted, route the next needs_revision verdict to a human checkpoint instead of looping forever."
  },
  "lanes": {
    "codex": {
      "adapter": "process",
      "display_model": "Codex GPT-5.5 xhigh",
      "command": ["codex", "--yolo"],
      "adapter_capabilities": {"agent_loop": true},
      "supervision": {"transport": "pty_helper", "compatible": true, "require_tmux": true},
      "capabilities": ["write", "review"]
    }
  },
  "roles": {
    "author": {"definition_path": "roles/author.md"},
    "reviewer": {"definition_path": "roles/reviewer.md"}
  },
  "context_docs": [],
  "parallelism": {
    "mode": "declared",
    "max_active_jobs": 1,
    "require_disjoint_write_scopes": true
  },
  "jobs": [
    {
      "id": "draft_change",
      "type": "draft",
      "title": "Draft change",
      "role_id": "author",
      "lane_id": "codex",
      "objective": "Draft the change to be reviewed.",
      "task_prompt": {"path": "prompts/draft.md"},
      "write_scope": {
        "mode": "repo_write",
        "repo_write": true,
        "allowed_paths": ["src/example/", "docs/failed-review/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "draft",
          "kind": "handoff",
          "path": "src/example/draft.py",
          "required": true
        }
      ]
    },
    {
      "id": "review_change",
      "type": "review",
      "title": "Review change",
      "role_id": "reviewer",
      "lane_id": "codex",
      "fresh_session_required": true,
      "objective": "Review the drafted change.",
      "task_prompt": {"path": "prompts/review.md"},
      "write_scope": {
        "mode": "review_only_artifact",
        "repo_write": false,
        "allowed_paths": ["docs/failed-review/"],
        "forbidden_paths": [".striatum/"]
      },
      "expected_artifacts": [
        {
          "logical_name": "review",
          "kind": "finding",
          "path": "docs/failed-review/REVIEW.md",
          "required": true
        }
      ]
    }
  ],
  "edges": [
    {"from": "draft_change", "to": "review_change", "on": "completed"}
  ],
  "cycles": [
    {
      "from": "review_change",
      "to": "draft_change",
      "on_verdict": "needs_revision",
      "max_iterations": 1
    }
  ]
}
